# ⚠️⚠️ DOCKER COMPOSE-ИЙН BUILD ХУВЬСАГЧ
#
# ЯАГААД ТУСДАА ФАЙЛ ВЭ: `docker-compose.yml`-ийн `args:` дэх
# `${...}` нь ОРЧНЫ хувьсагчаас уншина — `env_file` нь зөвхөн
# RUNTIME-д (container дотор) үйлчилнэ, BUILD үед хүрэхгүй.
#
# ⚠️ `NEXT_PUBLIC_*` нь BUILD үед код руу ШИГДДЭГ тул энд ЗААВАЛ.
#    Хоосон бол Next.js нь `new URL('')` дуудаж «Invalid URL»
#    алдаагаар build УНАНА (бодит алдаа).
#
# Хэрэглэх:
#   cp docker/.env.example docker/.env
#   docker compose -f bestfilm/docker/docker-compose.prod.yml -p bestfilm build

# ⚠️ R2 — BestTV-тэй ЯГ ИЖИЛ (кино нэг санд, зай 2 дахин эзлэхгүй)
NEXT_PUBLIC_ASSETS_URL=https://assets.besttv.us

# ⚠️ Чат — n8n нь `site` талбарыг `/chat/ingest` руу дамжуулна
NEXT_PUBLIC_CHAT_WEBHOOK_URL=https://bot.digitalger.mn/webhook/bestfilm-chat

# ⚠️ NextAuth — BestFilm-ийн домэйн (OAuth callback энэ дээр тулгуурлана)
NEXTAUTH_URL=https://bestfilm.net

# ⚠️⚠️ Хуваалцсан пакетын зам — ОРЧНООР ӨӨР:
#     локал: besttv/shared
#     VPS:   BestTV/shared   ← ТОМ үсэг
SHARED_DIR=besttv/shared
