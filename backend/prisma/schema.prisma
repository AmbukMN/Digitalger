generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER // энгийн хэрэглэгч (frontend)
  EDITOR // admin panel — зөвхөн ӨӨРИЙН контент create/edit (delete БАЙХГҮЙ)
  ADMIN // admin panel — зөвхөн ӨӨРИЙН контент бүрэн CRUD
  SUPERADMIN // бүх admin-ийг удирдах + бүх контент full (edit/delete/харах) + тохиргоо
}

enum ProductType {
  FILE
  TEMPLATE
  DOCUMENT
  VIDEO
  LESSON
  BUNDLE
  HYBRID
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String?        @unique
  name          String?
  passwordHash  String?
  image         String?
  role          Role           @default(USER)
  emailVerified DateTime?
  pendingEmail  String?
  phoneVerified DateTime? // утас баталгаажсан огноо (verify.mn MO SMS)
  pendingPhone  String?   // баталгаажуулж буй утас (verify хийж байж л phone солигдоно)
  oauthProvider String?
  oauthId       String?
  isGuest       Boolean        @default(false)
  blocked       Boolean        @default(false)
  refreshToken  String?
  // Marketing automation
  lastOrderAt        DateTime? // Сүүлийн PAID захиалгын огноо (inactive илрүүлэх)
  lastLoginAt        DateTime? // Сүүлийн нэвтрэлт (inactive илрүүлэх)
  reactivationSentAt DateTime? // Reactivation имэйл явуулсан (давхар явуулахгүй)
  // Хэрэглэгч unsubscribe дарвал MARKETING имэйл явуулахгүй (transactional хэвээр явна)
  marketingOptOut    Boolean   @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  reviews       Review[]
  downloads     Download[]
  downloadLogs  DownloadLog[]
  wishlists     Wishlist[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
  productEvents ProductEvent[]
  pageViews     PageView[]
  searchEvents  SearchEvent[]
  auditLogs     UserAuditLog[]
  lessonProgress LessonProgress[]
  lessonEvents  LessonEvent[]
  certificates   Certificate[]
  lessonQuestions LessonQuestion[]
  lessonAnswers  LessonAnswer[]
  quizAttempts   QuizAttempt[]
  chatConversations ChatConversation[]
  adminSeens     AdminSeen[]
  // ── Multi-tenant ownership: энэ admin-ийн үүсгэсэн контент (createdByUserId) ──
  ownedProducts     Product[]           @relation("ContentOwner")
  ownedCategories   Category[]          @relation("ContentOwner")
  ownedTypes        ProductTypeConfig[] @relation("ContentOwner")
  ownedTestimonials Testimonial[]       @relation("ContentOwner")
  ownedFaqs         FAQ[]               @relation("ContentOwner")
  ownedBlogPosts    BlogPost[]          @relation("ContentOwner")
  ownedBanners      Banner[]            @relation("ContentOwner")
  ownedHelpVideos   HelpVideo[]         @relation("ContentOwner")
  ownedPages        Page[]              @relation("ContentOwner")
  ownedCoupons      Coupon[]            @relation("ContentOwner")
  permissions       AdminPermission[]
}

// Granular permission — admin (ADMIN role) бүрд resource тус бүрээр эрх (Notion/Linear).
// ⚠️ SUPERADMIN-д энэ хүснэгт ХАМААРАХГҮЙ (бүх эрх автомат). ADMIN-д resource бүрд
// canView/Create/Edit/Delete. Бичлэг байхгүй resource = тэр resource-д хандах эрхгүй.
// Ownership хэвээр (өөрийн л дата) — permission нь "ямар resource-д хүрэх" хязгаар.
model AdminPermission {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource  String // products|categories|product-types|blog|banners|testimonials|faqs|coupons|pages|menu|orders|reviews
  canView   Boolean @default(true)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([userId, resource])
  @@index([userId])
}

// Admin sidebar "шинэ/уншаагүй" badge — admin хэсэг бүрийг сүүлд харсан огноо.
// Badge тоо = тухайн хэсгийн (Order/User/Subscriber/Review/Payment) createdAt > lastSeenAt.
// Admin хэсэгт орж харахад lastSeenAt=now() болж badge цэвэрлэгдэнэ (Gmail/Facebook шиг).
model AdminSeen {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  section    String // orders | users | subscribers | reviews | payments
  lastSeenAt DateTime @default(now())

  @@unique([adminId, section])
  @@index([adminId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  // ── Multi-tenant ownership (хэн үүсгэсэн admin) — null=хуучин/систем ──
  createdByUserId String?
  createdBy       User?   @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([createdByUserId])
}

model Product {
  id                String               @id @default(cuid())
  title             String
  slug              String               @unique
  description       String               @db.Text
  price             Decimal              @db.Decimal(12, 2)
  compareAtPrice    Decimal?             @db.Decimal(12, 2)
  type              String
  categoryId        String?
  categoryIds       String[]             @default([])
  category          Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  published         Boolean              @default(false)
  // Зөвхөн админд харагдах (туршилт) — true бол зочин/энгийн хэрэглэгчид бүх газар
  // (нүүр/жагсаалт/хайлт/detail/sitemap) нуугдана, зөвхөн admin role нэвтэрсэн үед харагдана.
  adminOnly         Boolean              @default(false)
  featured          Boolean              @default(false)
  rating            Float                @default(0)
  ratingCount       Int                  @default(0)
  downloadCount     Int                  @default(0) // ГАРААР тохируулсан "харагдах" тоо (frontend)
  realDownloadCount Int                  @default(0) // БОДИТ таталт (хэрэглэгч татах болгонд +1, зөвхөн admin)
  viewCount         Int                  @default(0) // БОДИТ үзэлт (хэрэглэгч product detail нээх болгонд +1)
  previewUrl        String?
  seoTitle          String?
  seoDescription    String?
  howToUse          String?              @db.Text
  howToUseSteps     Json                 @default("[]")
  whatsIncluded     String?              @db.Text
  discountEndsAt    DateTime?
  // Хандалтын хугацаа: LIFETIME (насан туршийн) эсвэл accessDays хоног (3/6/12 сар).
  // Хугацаатай бол худалдсан огнооноос accessDays-ийн дараа эрх дуусна (Order.expiresAt).
  accessType        String               @default("LIFETIME") // LIFETIME | DAYS
  accessDays        Int? // accessType=DAYS үед хоногийн тоо (90/180/365 гэх мэт)
  videoUrl          String?
  downloadFileKey   String?
  proofImageUrl     String?
  proofQuote        String?              @db.Text
  proofText         String?              @db.Text
  proofAuthorName   String?
  proofAuthorRole   String?
  // New product notification — subscriber-уудад имэйл явуулсан огноо (давхар явуулахгүй)
  notifiedAt        DateTime?
  // ── Multi-tenant ownership (хэн үүсгэсэн admin) ──
  createdByUserId   String?
  createdBy         User?                @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  files             ProductFile[]
  images            ProductImage[]
  course            Course?
  orderItems        OrderItem[]
  reviews           Review[]
  wishlists         Wishlist[]
  downloadLogs      DownloadLog[]
  faqs              ProductFAQ[]
  testimonials      ProductTestimonial[]
  bundles           ProductBundle[]

  @@index([createdByUserId])
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String
  fileKey   String
  mimeType  String?
  sizeBytes Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileKey   String         @default("")
  videoUrl  String?
  alt       String?
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)
  variants  ImageVariant[]
}

// Upload хийхэд үүсгэсэн WebP variant-уудыг хадгалана
// size: thumbnail(320px) | medium(800px) | large(1400px) | original
model ImageVariant {
  id             String       @id @default(cuid())
  productImageId String
  productImage   ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)
  size           String // 'thumbnail' | 'medium' | 'large' | 'original'
  fileKey        String // R2 key: 'uploads/uuid_thumbnail.webp'
  width          Int
  height         Int
  bytes          Int
  mimeType       String       @default("image/webp")
  createdAt      DateTime     @default(now())

  @@index([productImageId])
}

model Course {
  id        String         @id @default(cuid())
  productId String         @unique
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  modules   CourseModule[]
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  lessons   Lesson[]
}

model Lesson {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId      String?
  module        CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  // Видео эх сурвалж — 3 хувилбар (зэрэг дэмжинэ, аль нэг нь):
  //   videoStreamId → Cloudflare Stream (ШИНЭ хичээлийн видео, signed playback)
  //   videoKey      → R2 (хуучин хичээлийн видео, presigned)
  //   videoUrl      → гадаад линк (YouTube/Vimeo)
  videoKey      String?
  videoUrl      String?
  videoStreamId String?       // Cloudflare Stream UID
  streamStatus  String?       // pending | ready | error (Stream боловсруулалтын төлөв)
  // Видео thumbnail/poster — admin upload (R2 key). Эс тохируулбал видеоны эхний
  // frame (Stream автомат thumbnail / R2 видео эхний 2сек) ашиглана.
  posterKey     String?
  durationSec   Int?
  isFreePreview Boolean       @default(false)
  sortOrder     Int           @default(0)
  // Хичээлийн доорх дэлгэрэнгүй агуулга (rich text notes — TipTap HTML, код/зураг)
  content       String?       @db.Text
  progress      LessonProgress[]
  resources     LessonResource[]
  questions      LessonQuestion[]
  quiz           Quiz?
}

// Хичээлд хавсаргасан татаж авах нөөц (PDF, файл, материал — R2-д хадгалагдана).
model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileKey   String // R2 key
  fileName  String
  mimeType  String?
  sizeBytes Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([lessonId])
}

// Хичээл үзэлтийн явц — continue watching + дууссан тэмдэглэгээ.
model LessonProgress {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  watchedSeconds Int      @default(0) // сүүлд зогссон байрлал (continue watching)
  durationSec    Int? // тухайн видеоны нийт урт
  completed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

// Сертификат — курс 100% дуусгасан хэрэглэгчид олгоно (PDF татах).
model Certificate {
  id         String   @id @default(cuid())
  certNo     String   @unique // нийтийн дугаар (баталгаажуулахад)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String // курсын бүтээгдэхүүн
  courseTitle String
  userName   String
  issuedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// Хичээлийн Q&A — хэрэглэгч асуулт асууж, admin/багш хариулна.
model LessonQuestion {
  id        String           @id @default(cuid())
  lessonId  String
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String           @db.Text
  isPinned  Boolean          @default(false)
  // ⚠️ Admin уншаагүй мэдэгдэл: хэрэглэгч асуулт асуух / хэрэглэгчийн (isInstructor=false)
  // шинэ хариулт ирэхэд true. Admin тухайн асуултыг НЭЭЖ харахад false болгоно.
  // Sidebar + жагсаалтын "шинэ/уншаагүй" badge энэ талбараас тоологдоно.
  adminUnread Boolean        @default(true)
  // Хавсралт (image/file) — R2 key, нийтэд presigned URL-аар үзүүлнэ.
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt DateTime         @default(now())
  answers   LessonAnswer[]

  @@index([lessonId, createdAt])
  @@index([adminUnread])
}

model LessonAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     String         @db.Text
  isInstructor Boolean      @default(false) // admin/багшийн хариулт онцлох
  // Хавсралт (image/file) — R2 key, presigned URL-аар үзүүлнэ.
  attachmentKey      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt  DateTime       @default(now())

  @@index([questionId, createdAt])
}

// Хичээлийн дараах шалгалт (quiz).
model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique // нэг хичээлд нэг quiz
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  passScore Int            @default(60) // тэнцэх хувь
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  createdAt DateTime       @default(now())
}

model QuizQuestion {
  id        String       @id @default(cuid())
  quizId    String
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question  String       @db.Text
  options   String[] // сонголтууд
  correctIndex Int // зөв хариултын индекс
  sortOrder Int          @default(0)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int // авсан хувь
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, quizId])
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total            Decimal     @db.Decimal(12, 2)
  currency         String      @default("MNT")
  status           OrderStatus @default(PENDING)
  // Захиалгын эх сурвалж: "PURCHASE" (хэрэглэгч мөнгөөр) | "ADMIN_GRANT" (админ үнэгүй идэвхжүүлсэн)
  source           String      @default("PURCHASE")
  grantedByAdminId String? // ADMIN_GRANT үед идэвхжүүлсэн админ
  // Цуцлалтын эх сурвалж — admin UI-д ялгаж харуулна:
  //   "USER" (хэрэглэгч өөрөө), "SYSTEM" (cron — PENDING хугацаа дуусч автомат), "ADMIN" (админ гараар)
  cancelledBy      String?
  cancelledAt      DateTime?
  qpayIdentifier   String?     @unique
  couponCode       String?
  // Marketing automation — давхар имэйл явуулахаас сэргийлэх тэмдэглэгээ
  reminderSentAt     DateTime? // Cart abandonment (1ц) сануулга явуулсан огноо
  discountPushSentAt DateTime? // Discount push (24ц) 10% coupon follow-up явуулсан
  // Хандалтын хугацаа: PAID болох үед бүтээгдэхүүний accessType-аас хамаарч тооцно.
  //   paidAt    — төлбөр баталгаажсан огноо
  //   expiresAt — null бол насан туршийн (LIFETIME); огноо бол түүнээс хойш эрх дуусна
  paidAt           DateTime?
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
  payments         Payment[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId, source])
  @@index([userId, expiresAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal @db.Decimal(12, 2)

  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  qpayPaymentId String?
  rawPayload    Json?
  createdAt     DateTime      @default(now())
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?  @db.Text
  authorName String? // харагдах нэр (хоосон бол user.name)
  updatedAt  DateTime @default(now()) @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, productId]) // нэг хэрэглэгч нэг бүтээгдэхүүнд нэг review
  @@index([productId, createdAt]) // pagination — сүүлийнх эхэнд
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([fileId])
}

// Татаалтын дэлгэрэнгүй бүртгэл — admin "хэн/хэзээ/хаанаас юу татсан" харна.
// Download (file-level түүх)-аас ялгаатай: энэ нь бүтээгдэхүүн түвшний, зочин (guest)
// + IP/source/device-тэй, нэвтрээгүй татаалтыг ч бүртгэнэ.
model DownloadLog {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId    String? // null = нэвтрээгүй зочин
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fileName  String? // татсан файл/zip нэр (resolve хийсэн)
  source    String   @default("paid") // "paid" | "free" | "bundle"
  ip        String? // зочин/хэрэглэгчийн IP
  userAgent String? // төхөөрөмж/browser
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  // info | order | lesson | coupon | certificate — UI-д icon/өнгө сонгоход
  type      String   @default("info")
  // Дарахад очих route (ж /library, /orders). null бол зүгээр уншина.
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model ThemeSetting {
  id             String   @id @default("default")
  primaryColor   String   @default("221 83% 53%")
  secondaryColor String   @default("210 40% 96%")
  accentColor    String   @default("262 83% 58%")
  layoutMode     String   @default("light")
  defaultTheme   String   @default("system")
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id           String  @id @default("default")
  siteName     String  @default("DigitalGer")
  siteUrl      String  @default("https://digitalger.mn")
  supportEmail String?
  logoUrl      String?

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogTitle         String?
  ogDescription   String?
  ogImageUrl      String?
  twitterCardType String? @default("summary_large_image")
  robotsNoIndex   Boolean @default(false)
  robotsNoFollow  Boolean @default(false)
  canonicalUrl    String?

  // Analytics & Verification
  googleAnalyticsId      String?
  googleTagManagerId     String?
  fbPixelId              String?
  googleSiteVerification String?
  naverSiteVerification  String?

  // Sitemap
  sitemapEnabled    Boolean @default(true)
  sitemapChangeFreq String? @default("weekly")
  sitemapPriority   String? @default("0.8")

  // Social links
  socialFacebook  String?
  socialInstagram String?
  socialTwitter   String?
  socialThreads   String?
  socialTelegram  String?
  socialWhatsapp  String?
  socialTiktok    String?
  socialYoutube   String?
  socialLinkedin  String?

  // Сертификатын тохиргоо — admin-аас upload (гарын үсэг зураг + гарын үсэг зурах хүн)
  certSignatureUrl  String? // гарын үсгийн зураг (R2 key/url) — admin upload
  certSignerName    String? @default("Б. Амгаланбаяр") // гарын үсэг зурах хүний нэр
  certSignerTitle   String? @default("Гүйцэтгэх захирал") // албан тушаал

  updatedAt DateTime @updatedAt
}

model Banner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String
  mobileImageUrl  String?
  desktopImageUrl String?
  videoUrl        String?
  linkUrl         String?
  linkLabel       String?
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  bgColor         String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String?
  createdBy       User?     @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([createdByUserId])
}

// ── FAQ: standalone, assigned to products via many-to-many ──
model FAQ {
  id        String       @id @default(cuid())
  question  String
  answer    String       @db.Text
  category  String?
  active    Boolean      @default(true)
  // Help Assistant panel-ийн FAQ tab-д харуулах эсэх (admin checkbox-оор сонгоно)
  showInHelp Boolean     @default(false)
  sortOrder Int          @default(0)
  createdByUserId String?
  createdBy       User?    @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  ProductFAQ[]

  @@index([active, sortOrder])
  @@index([showInHelp, active])
  @@index([createdByUserId])
}

// ── HelpVideo: Help Assistant panel-ийн "Видео заавар" tab-ийн контент ──
// Видео эх сурвалж 3 хувилбар (Lesson-той ижил): videoUrl (YouTube/гадаад),
// videoKey (R2 public), videoStreamId (Cloudflare Stream). posterKey = thumbnail.
model HelpVideo {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  videoUrl        String?   // YouTube/Vimeo гадаад линк
  videoKey        String?   // R2 public URL — HLS m3u8 (шинэ) эсвэл mp4 (хуучин)
  videoStreamId   String?   // Cloudflare Stream uid (ашиглахгүй — энгийн видео R2)
  posterKey       String?   // Thumbnail зураг (R2 эсвэл гадаад URL)
  durationLabel   String?   // "0:30", "1:20" гэх мэт харуулах шошго
  // HLS хөрвүүлэлтийн төлөв: null/ready=бэлэн, processing=worker хөрвүүлж байна, error
  streamStatus    String?   @default("ready")
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  createdByUserId String?
  createdBy       User?     @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([createdByUserId])
}

model ProductFAQ {
  productId String
  faqId     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  faq       FAQ     @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@id([productId, faqId])
}

// ── Testimonials ──
model Testimonial {
  id        String               @id @default(cuid())
  name      String
  avatar    String?
  role      String?
  content   String               @db.Text
  rating    Int                  @default(5)
  featured  Boolean              @default(true)
  active    Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdByUserId String?
  createdBy       User?          @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  products  ProductTestimonial[]

  @@index([active, featured, sortOrder])
  @@index([createdByUserId])
}

model ProductTestimonial {
  productId     String
  testimonialId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@id([productId, testimonialId])
}

// ── Product Bundles / Content Groups ──
model ProductBundle {
  id              String       @id @default(cuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sortOrder       Int          @default(0)
  downloadFileKey String?
  items           BundleItem[]

  @@index([productId, sortOrder])
}

model BundleItem {
  id          String        @id @default(cuid())
  bundleId    String
  bundle      ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  name        String
  description String?
  label       String?
  fileId      String?
  fileIds     String[]      @default([])
  sortOrder   Int           @default(0)

  @@index([bundleId, sortOrder])
}

// ── Product Type Configuration ──
model ProductTypeConfig {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdByUserId String?
  createdBy       User?  @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([createdByUserId])
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  url       String?
  pageSlug  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  target    String   @default("_self")
  openInNew Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?   @db.Text
  content       String    @db.Text
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  tags          String[]
  authorName    String    @default("DigitalGer")
  sortOrder     Int       @default(0)
  viewCount     Int       @default(0) // БОДИТ уншилт (хэрэглэгч нийтлэл нээх болгонд +1)
  createdByUserId String?
  createdBy       User?   @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([createdByUserId])
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  // SEO талбарууд — page бүрд admin-аас тохируулна (generateMetadata уншина)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImageUrl      String?
  createdByUserId String?
  createdBy       User?    @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([createdByUserId])
}

// Тодорхой URL (тогтмол хуудас)-д custom OG meta — admin-аас add/edit/delete.
// path нь зөвхөн БОДИТ route байх ёстой (backend allow-list шалгана, 404 биш).
// Жишээ: /products, /categories, /blog, /, /search. generateMetadata энэ override-ийг
// уншиж тухайн хуудсанд og:image/title/description тавина.
model SeoOverride {
  id              String   @id @default(cuid())
  path            String   @unique // /products гэх мэт (эхэндээ / -тай)
  title           String?
  description     String?
  ogImageUrl      String?
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())
}

// ─── Имэйл захиалагч (newsletter / marketing) ────────────────────────────────
enum SubscriberStatus {
  ACTIVE
  INACTIVE
  UNSUBSCRIBED
}

enum SubscriberSex {
  MALE
  FEMALE
  OTHER
}

model SubscriberCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  // Системийн категори (web-д бүртгүүлсэн г.м.) — устгахаас хамгаална
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subscribers Subscriber[]
}

model Subscriber {
  id           String              @id @default(cuid())
  email        String              @unique
  firstName    String?
  lastName     String?
  age          Int?
  sex          SubscriberSex?
  phone        String?
  status       SubscriberStatus    @default(ACTIVE)
  // source: homepage | free-ppt | checkout | popup | web-register | admin | import
  source       String?
  tags         String[]            @default([])
  isActive     Boolean             @default(true)
  category     SubscriberCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId   String?
  // Хэрэв нэвтэрсэн хэрэглэгчтэй холбоотой бол (web-register source)
  userId       String?
  lastEmailAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([source])
  @@index([email])
}

// Имэйл нээлт хянах (tracking pixel) — marketing имэйл бүрд 1×1 зураг суулгаж,
// хэрэглэгч нээхэд энэ бүртгэгдэнэ. campaign-аар нээлтийн статистик гаргана.
model EmailOpen {
  id        String   @id @default(cuid())
  email     String
  campaign  String // cart-1h | discount-24h | coupon-expiring | new-product | reactivation | welcome ...
  refId     String? // order/coupon/product id (холбоотой бол)
  openedAt  DateTime @default(now())

  @@index([campaign, openedAt])
  @@index([email, campaign])
}

// ── AWS SES Enterprise email infrastructure ──────────────────────────────────

// Илгээсэн имэйл бүрийн лог (audit, status tracking).
//   status: queued | sent | delivered | bounced | complained | failed
model EmailLog {
  id           String   @id @default(cuid())
  to           String
  subject      String
  campaign     String? // marketing campaign нэр (transactional бол null)
  provider     String   @default("ses") // ses | resend
  status       String   @default("queued")
  messageId    String? // SES MessageId (bounce/complaint match хийхэд)
  errorMessage String?  @db.Text
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?

  @@index([to, createdAt])
  @@index([status, createdAt])
  @@index([messageId])
  @@index([campaign, createdAt])
}

// Suppression list — bounce/complaint/manual хаягууд. Энд байгаа хаягт ХЭЗЭЭ Ч
// имэйл явуулахгүй (send-ийн өмнө шалгана) — sender reputation хамгаална.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // bounce | complaint | manual
  // bounce subType: Permanent | Transient | Undetermined; complaint: abuse гэх мэт
  subType   String?
  detail    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([reason, createdAt])
}

// Чатбот харилцаа (web chat / FB / IG) — admin хэрэглэгчийн дэлгэрэнгүйд харах.
// n8n workflow-аас мессеж бүрийг backend-д хадгална. Нэвтрээгүй (зочин) үеийн
// chat-ийг sessionId-аар хадгалж, хэрэглэгч нэвтрэхэд userId-д холбоно (backfill).
model ChatConversation {
  id        String        @id @default(cuid())
  channel   String // web | facebook | instagram
  sessionId String        @unique // web_xxx | psid (FB) | ig id
  userId    String? // нэвтэрсэн хэрэглэгчтэй холбогдвол (backfill)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String? // FB/IG-ийн нэр (n8n profile-аас)
  userImage String? // FB/IG profile зураг (n8n Get User Profile-аас) — admin chat-д
  lastMessageAt DateTime  @default(now())
  // ── Admin human-handoff (gar hariu) талбарууд ──
  // adminUnread: хэрэглэгч шинэ мессеж бичсэн → admin уншаагүй (sidebar badge).
  adminUnread     Boolean @default(false)
  // handedOff: admin "чатыг авсан" → AI хариулахаа болино, зөвхөн admin хариулна.
  handedOff       Boolean @default(false)
  // userUnreadCount: admin бичсэн, хэрэглэгч хараагүй мессежийн тоо (floating badge).
  userUnreadCount Int     @default(0)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([channel, lastMessageAt])
  @@index([adminUnread, lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  text           String           @db.Text
  // AI бот санал болгосон бүтээгдэхүүний card (carousel) — хэрэглэгчид харагдсан
  // яг тэр products. Admin чатыг ЯГ хэрэглэгчийн харсанчлан (card-тай) харна.
  // n8n assistant мессеж дээр дамжуулна. ChatProduct[]: {id,title,price,salePrice,imageUrl,url}
  products       Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

enum ZipJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model ZipJob {
  id        String       @id @default(cuid())
  userId    String? // null = үнэгүй бүтээгдэхүүний нийтийн (нэвтрээгүй) zip
  productId String?
  status    ZipJobStatus @default(PENDING)
  zipKey    String?
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, productId, status])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(12, 2)
  minPrice  Decimal?   @db.Decimal(12, 2)
  maxUses   Int?
  usedCount Int        @default(0)
  active    Boolean    @default(true)
  expiresAt DateTime?
  // Expiring coupon reminder (дуусахаас 12ц өмнө) давхар явуулахаас сэргийлэх
  reminderSentAt DateTime?
  createdByUserId String?
  createdBy       User?    @relation("ContentOwner", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdByUserId])
}

model EmailOtp {
  id         String   @id @default(cuid())
  email      String
  otpHash    String
  purpose    String   @default("verify")
  expiresAt  DateTime
  attempts   Int      @default(0)
  sentCount  Int      @default(0)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([email, purpose])
}

// Verify.mn MO SMS утас баталгаажуулалт. Хэрэглэгч 144773 руу `code`-г SMS илгээнэ.
// verifyMnSessionId = verify.mn-ийн session. callback/polling-аар VERIFIED болоход
// User.phoneVerified=now болгоно. EmailOtp шиг FK-гүй (гар аргаар цэвэрлэнэ).
model PhoneVerifySession {
  id               String   @id @default(cuid())
  userId           String
  phone            String // баталгаажуулж буй утас
  code             String // 144773 руу илгээх код (4-6 орон)
  verifyMnSessionId String  @unique // verify.mn-ийн sessionId
  status           String   @default("pending") // pending|verified|expired
  expiresAt        DateTime
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, status])
  @@index([verifyMnSessionId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  country   String?
  device    String? // mobile | desktop | tablet
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ProductEvent {
  id          String   @id @default(cuid())
  type        String // view | click | cart | purchase
  productId   String
  productSlug String
  sessionId   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device      String? // mobile | desktop | tablet
  createdAt   DateTime @default(now())

  @@index([productId, type, createdAt])
  @@index([type, createdAt])
  @@index([productSlug, type])
  @@index([userId, type, createdAt])
}

// Хэрэглэгчийн аккаунтын өөрчлөлтийн түүх (email/phone/name/password солих)
model UserAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field     String // email | phone | name | password | role | blocked | login | register | guest_login | oauth_login | password_reset
  oldValue  String?
  newValue  String?
  actor     String // self | admin | system
  actorId   String? // солисон admin-ийн id (admin бол)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SearchEvent {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  sessionId String?
  userId    String? // нэвтэрсэн бол хэрэглэгчид холбоно (admin popup хайлтын түүх)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([query, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// Хичээлийн (course lesson) видео үзэлтийн analytics event.
// ProductEvent-тэй ижил fail-open хэв маяг: lessonId/productId-д хатуу FK тавихгүй
// (устсан/хуурамч id-аас sendBeacon insert унахаас сэргийлж). Зөвхөн userId л
// бодит User-тэй холбогддог (бусад event model-тэй адил, onDelete: SetNull).
//   event:
//     lesson_started   — видео тоглож эхлэх агшин
//     lesson_completed — үзэж дуусгасан (watchedSeconds/durationSec-той)
//     lesson_progress  — явцын босго (25/50/75% эсвэл 60сек тутам) — watch_duration
//                        + dropoff (position) шинжилгээнд
model LessonEvent {
  id             String   @id @default(cuid())
  event          String // lesson_started | lesson_completed | lesson_progress
  lessonId       String
  productId      String? // тухайн хичээл хамаарах course-ийн productId (байвал)
  sessionId      String?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  watchedSeconds Int? // нийт үзсэн секунд (completed/progress)
  durationSec    Int? // видеоны нийт урт
  playbackSpeed  Float? // тоглуулах хурд (1.0 / 1.25 / 1.5 / 2.0 ...)
  position       Int? // явцын байрлал секундээр (dropoff шинжилгээ)
  device         String? // mobile | desktop | tablet
  createdAt      DateTime @default(now())

  @@index([lessonId, event])
  @@index([event, createdAt])
  @@index([productId, event, createdAt])
  @@index([userId, createdAt])
}

// FB/IG доторх браузараас системийн браузар (Safari/Chrome) руу шилжихэд
// хэрэглэгчийн state (сагс/wishlist/coupon/guest)-ийг түр хадгална. Шинэ
// браузар богино token-оор сэргээнэ — хэрэглэгч дахин сагслах шаардлагагүй.
// Нэг удаагийн (used), богино настай (expiresAt ~30мин).
model TransferState {
  id        String   @id @default(cuid())
  payload   Json // { cart, wishlist, coupons, guest } JSON
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// R2 orphan файлын "хогийн сав" — R2-д байгаа ч DB-д холбоогүй файлыг шууд устгахгүй,
// эхэлж энд бүртгэж (firstSeenAt) GRACE хугацаа (3 хоног) хүлээнэ. Тэр хугацаанд DB-д
// дахин холбогдвол энэ бүртгэлээс хасна (хамгаалагдана). 3 хоног orphan хэвээр байвал
// л R2-аас бодитоор устгана. (2 шатлалт soft→hard delete — санамсаргүй устгахаас сэргийлэх.)
model OrphanCandidate {
  id          String   @id @default(cuid())
  key         String   @unique // R2 object key
  size        Int? // байт (лог/статистикт)
  firstSeenAt DateTime @default(now()) // эхэлж orphan гэж илрүүлсэн огноо (grace эхлэл)
  lastSeenAt  DateTime @default(now()) // сүүлд orphan хэвээр байсныг баталгаажуулсан
  createdAt   DateTime @default(now())

  @@index([firstSeenAt])
}

// Холбоо барих (contact form) мессеж — өмнө зөвхөн имэйлд явдаг байсныг DB-д бас
// хадгална (алдагдахаас сэргийлж admin-д жагсаалт + notify). Имэйл явуулалт хэвээр.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String    @db.Text
  read      Boolean   @default(false)
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([read, createdAt])
}
