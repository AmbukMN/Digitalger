generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  FILE
  TEMPLATE
  DOCUMENT
  VIDEO
  LESSON
  BUNDLE
  HYBRID
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String?        @unique
  name          String?
  passwordHash  String?
  image         String?
  role          Role           @default(USER)
  emailVerified DateTime?
  oauthProvider String?
  oauthId       String?
  isGuest       Boolean        @default(false)
  refreshToken  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  reviews       Review[]
  downloads     Download[]
  wishlists     Wishlist[]
  notifications Notification[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String               @id @default(cuid())
  title          String
  slug           String               @unique
  description    String               @db.Text
  price          Decimal              @db.Decimal(12, 2)
  compareAtPrice Decimal?             @db.Decimal(12, 2)
  type           ProductType
  categoryId     String?
  categoryIds    String[]             @default([])
  category       Category?            @relation(fields: [categoryId], references: [id])
  published      Boolean              @default(false)
  featured       Boolean              @default(false)
  rating         Float                @default(0)
  ratingCount    Int                  @default(0)
  downloadCount  Int                  @default(0)
  previewUrl     String?
  seoTitle       String?
  seoDescription String?
  howToUse       String?              @db.Text
  howToUseSteps  Json                 @default("[]")
  whatsIncluded  String?              @db.Text
  discountEndsAt DateTime?
  videoUrl       String?
  proofImageUrl  String?
  proofQuote     String?              @db.Text
  proofText      String?              @db.Text
  proofAuthorName String?
  proofAuthorRole String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  files          ProductFile[]
  images         ProductImage[]
  course         Course?
  orderItems     OrderItem[]
  reviews        Review[]
  wishlists      Wishlist[]
  faqs           ProductFAQ[]
  testimonials   ProductTestimonial[]
  bundles        ProductBundle[]
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String
  fileKey   String
  mimeType  String?
  sizeBytes Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileKey   String   @default("")
  videoUrl  String?
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
}

model Course {
  id        String        @id @default(cuid())
  productId String        @unique
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  modules   CourseModule[]
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  lessons   Lesson[]
}

model Lesson {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId      String?
  module        CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  videoKey      String?
  videoUrl      String?
  durationSec   Int?
  isFreePreview Boolean       @default(false)
  sortOrder     Int           @default(0)
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  total          Decimal     @db.Decimal(12, 2)
  currency       String      @default("MNT")
  status         OrderStatus @default(PENDING)
  qpayIdentifier String?     @unique
  couponCode     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  payments       Payment[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Decimal @db.Decimal(12, 2)
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  qpayPaymentId String?
  rawPayload    Json?
  createdAt     DateTime      @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fileId    String
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ThemeSetting {
  id             String   @id @default("default")
  primaryColor   String   @default("221 83% 53%")
  secondaryColor String   @default("210 40% 96%")
  accentColor    String   @default("262 83% 58%")
  layoutMode     String   @default("light")
  defaultTheme   String   @default("system")
  updatedAt      DateTime @updatedAt
}

model SiteSetting {
  id           String   @id @default("default")
  siteName     String   @default("DigitalGer")
  siteUrl      String   @default("https://digitalger.mn")
  supportEmail String?
  logoUrl      String?
  updatedAt    DateTime @updatedAt
}

model Banner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String
  mobileImageUrl  String?
  desktopImageUrl String?
  videoUrl        String?
  linkUrl         String?
  linkLabel       String?
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  bgColor         String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active, sortOrder])
}

// ── FAQ: standalone, assigned to products via many-to-many ──
model FAQ {
  id        String       @id @default(cuid())
  question  String
  answer    String       @db.Text
  category  String?
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  products  ProductFAQ[]

  @@index([active, sortOrder])
}

model ProductFAQ {
  productId String
  faqId     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  faq       FAQ     @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@id([productId, faqId])
}

// ── Testimonials ──
model Testimonial {
  id        String               @id @default(cuid())
  name      String
  avatar    String?
  role      String?
  content   String               @db.Text
  rating    Int                  @default(5)
  featured  Boolean              @default(true)
  active    Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  products  ProductTestimonial[]

  @@index([active, featured, sortOrder])
}

model ProductTestimonial {
  productId     String
  testimonialId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)

  @@id([productId, testimonialId])
}

// ── Product Bundles / Content Groups ──
model ProductBundle {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int          @default(0)
  items       BundleItem[]

  @@index([productId, sortOrder])
}

model BundleItem {
  id          String        @id @default(cuid())
  bundleId    String
  bundle      ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  name        String
  description String?
  label       String?
  fileId      String?
  fileIds     String[]      @default([])
  sortOrder   Int           @default(0)

  @@index([bundleId, sortOrder])
}

// ── Product Type Configuration ──
model ProductTypeConfig {
  id          String   @id @default(cuid())
  value       String   @unique
  label       String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  url       String?
  pageSlug  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  target    String   @default("_self")
  openInNew Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?   @db.Text
  content       String    @db.Text
  coverImageUrl String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  tags          String[]
  authorName    String    @default("DigitalGer")
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  updatedAt DateTime @updatedAt @default(now())
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Decimal    @db.Decimal(12, 2)
  minPrice  Decimal?   @db.Decimal(12, 2)
  maxUses   Int?
  usedCount Int        @default(0)
  active    Boolean    @default(true)
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
