# DigitalGer Backend — Environment Variables
# Copy to .env for local development.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Database (Docker postgres runs on 5433 locally)
DATABASE_URL=postgresql://digitalger:digitalger_secret@localhost:5433/digitalger?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digitalger-assets
R2_ENDPOINT=
R2_PUBLIC_URL=https://assets.digitalger.mn

# QPay
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/api/payments/webhook
QPAY_WEBHOOK_SECRET=

# AWS SES (email delivery)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=noreply@digitalger.mn
# --- Resend (имэйл, AWS SES-ийн оронд түр) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Anthropic AI (optional — admin AI features)
ANTHROPIC_API_KEY=
