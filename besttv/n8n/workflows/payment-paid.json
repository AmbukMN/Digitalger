        240,
        300
      ],
      "webhookId": "besttv00-0000-0000-0000-000000000001"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "besttv-0001-cond",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "payment.paid",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "besttv-0001-node-filter",
      "name": "Filter",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "/**\n * ⚠️ Telegram HTML — зөвхөн <b> <i> <code>. Markdown БИШ\n * (тусгай тэмдэгт escape шаардана, монгол хашилтад асуудалтай).\n */\nconst b = $input.item.json.body;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst money = (n) => Number(n ?? 0).toLocaleString('mn-MN') + '₮';\n\nconst METHOD = { QPAY: 'QPay', WALLET: 'Хэтэвч', BANK: 'Данс' };\nconst what = b.isWalletTopup\n  ? 'Хэтэвч цэнэглэлт'\n  : b.planName ? 'Багц: ' + esc(b.planName)\n  : b.titleName ? 'Түрээс: ' + esc(b.titleName)\n  : 'Тодорхойгүй';\n\nconst user = [b.userName, b.userEmail].filter(Boolean).map(esc).join(' · ')\n  || 'Тодорхойгүй';\nconst when = new Date(b.paidAt || Date.now())\n  .toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' });\n\nconst message =\n  '<b>💰 Төлбөр орлоо</b>\\n\\n' +\n  what + '\\n' +\n  '<b>' + money(b.amount) + '</b> · ' + (METHOD[b.method] || b.method) + '\\n' +\n  '👤 ' + user + '\\n' +\n  (b.couponCode ? '🎟 Купон: <code>' + esc(b.couponCode) + '</code>\\n' : '') +\n  '🕐 ' + when;\n\nreturn [{ json: { message } }];\n"
      },
      "id": "besttv-0001-node-code",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "__CHAT_ID__",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "besttv-0001-node-tg",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "besttv-0001-node-resp",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
