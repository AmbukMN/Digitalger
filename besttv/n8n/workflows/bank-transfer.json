      "id": "besttv-0002-node-filter",
      "name": "Filter",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "/**\n * ⚠️ ЭНЭ НЬ ҮЙЛДЭЛ ШААРДСАН мэдэгдэл — админ гараар\n * баталгаажуулна. Гүйлгээний утга нь ХАМГИЙН ТОД (code блок,\n * телефоноос шууд хуулахад амар).\n */\nconst b = $input.item.json.body;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst money = (n) => Number(n ?? 0).toLocaleString('mn-MN') + '₮';\n\nconst what = b.planName ? esc(b.planName)\n  : b.titleName ? esc(b.titleName) : 'Тодорхойгүй';\nconst user = [b.userName, b.userEmail].filter(Boolean).map(esc).join(' · ')\n  || 'Тодорхойгүй';\nconst when = new Date(b.claimedAt || Date.now())\n  .toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' });\n\nconst message =\n  '<b>🏦 ДАНСААР ШИЛЖҮҮЛЭВ — шалгана уу</b>\\n\\n' +\n  'Гүйлгээний утга:\\n<code>' + esc(b.reference) + '</code>\\n\\n' +\n  what + '\\n' +\n  '<b>' + money(b.amount) + '</b>\\n' +\n  '👤 ' + user + '\\n' +\n  '🕐 ' + when + '\\n\\n' +\n  '<i>Админ панел → Дансны төлбөр</i>';\n\nreturn [{ json: { message } }];\n"
      },
      "id": "besttv-0002-node-code",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "__CHAT_ID__",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "besttv-0002-node-tg",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
