        "path": "besttv-video-failed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "besttv-0004-node-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "besttv00-0000-0000-0000-000000000004"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "besttv-0004-cond",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "video.failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "besttv-0004-node-filter-secret",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "__WEBHOOK_SECRET__",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "besttv-0004-node-filter",
      "name": "Filter",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.item.json.body;\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst what = b.episodeLabel\n  ? esc(b.titleName) + ' — ' + esc(b.episodeLabel)\n  : esc(b.titleName);\n\nconst message =\n  '<b>⚠️ Хөрвүүлэлт амжилтгүй</b>\\n\\n' +\n  '🎬 ' + what + '\\n' +\n  'Оролдлого: ' + (b.attempts ?? 1) + '\\n' +\n  '<code>' + esc(String(b.reason).slice(0, 300)) + '</code>';\n\nreturn [{ json: { message } }];\n"
      },
      "id": "besttv-0004-node-code",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "__CHAT_ID__",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      },
      "id": "besttv-0004-node-tg",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "besttv-0004-node-resp",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
