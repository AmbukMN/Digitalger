# ── BestTV Backend — ТУСДАА .env (DigitalGer-ээс хамааралгүй) ────────────────
NODE_ENV=development
PORT=4100

# Postgres — БҮРЭН ТУСДАА container (besttv/docker/docker-compose.yml, порт 5434)
DATABASE_URL=postgresql://besttv:besttv_secret@localhost:5434/besttv?schema=public

# Redis — БҮРЭН ТУСДАА container (порт 6380)
REDIS_URL=redis://localhost:6380

# JWT — DigitalGer-ээс ӨӨР secret ашиглана!
JWT_SECRET=change-me-besttv-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-besttv-refresh
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 — ТУСДАА account, PRIVATE bucket (public URL ХЭРЭГГҮЙ —
# бүх хандалт presigned URL-ээр. R2_PUBLIC_URL зориуд байхгүй!)
# ⚠️ Хоосон орхивол автоматаар ЛОКАЛ ДИСК драйвер ажиллана (storage/ хавтас,
# доорх BACKEND_URL-ээр /media/* serve хийнэ) — R2 бэлэн болмогц энд бөглөнө.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=besttv
R2_ENDPOINT=

# QPay — DigitalGer-ийн merchant-ийг ХАМТРАН ашиглана (утгуудыг хуулна)
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4100/api/payments/qpay/callback
QPAY_WEBHOOK_SECRET=

# ── Bonum Gateway (карт · Apple Pay · Google Pay · WeChat) ──────────────
# ⚠️ Credential нь DIGITALGER merchant дээр бүртгэлтэй — invoice-д брэнд
#    нэр ОГТ явуулахгүй (QPay-тэй ижил зарчим).
# ⚠️ Test: https://testapi.bonum.mn | Production: https://apis.bonum.mn
# ⚠️ CALLBACK_URL-ыг merchant.bonum.mn дээр ЗААВАЛ бүртгүүлнэ.
# ⚠️ Тохируулаагүй бол карт/Apple/Google/WeChat сонголт ГАРАХГҮЙ —
#    QPay/данс/хэтэвч хэвэвчлэн ажиллана (зэрэгцээ зам).
BONUM_BASE_URL=https://testapi.bonum.mn
BONUM_APP_SECRET=
BONUM_TERMINAL_ID=
BONUM_CHECKSUM_KEY=
BONUM_CALLBACK_URL=http://localhost:4100/api/payments/bonum/callback

# TMDB — admin контент import (үнэгүй API key: themoviedb.org)
TMDB_API_KEY=e4fb196f4e1f071e5423c01ec86a8d89

# OAuth — Google/Facebook Client ID/Secret нь FRONTEND-ийн .env.local-д
# байрлана (NextAuth). Backend зөвхөн frontend-ээс profile хүлээж авах
# нэг endpoint-той (/api/auth/oauth) — энд өөр key шаардлагагүй.

# URLs
FRONTEND_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
CORS_ORIGIN=http://localhost:3100,http://localhost:3101

# R2 тохируулаагүй үед storage/ хавтасны файлыг энэ хаягаар serve хийнэ
# (/media/*). VPS дээр домэйн/IP-ээ тавина (ж: https://api.besttv.us)
BACKEND_URL=http://localhost:4100

# ─── AI орчуулга ──────────────────────────────────────────────────────
# TMDB-ээс ирдэг АНГЛИ тайлбар/дүрийн нэрийг монгол руу утгачилж хөрвүүлнэ.
# ⚠️ ЭНЭ ФАЙЛ GIT-Д ОРДОГ — жинхэнэ түлхүүрийг ЗӨВХӨН `.env`-д бич.
# ⚠️ Аль нэгийг нь л тавина (хоёул байвал OpenAI-г сонгоно).
# ⚠️ Тохируулаагүй бол орчуулга алгасна — англи хэвээр орно (алдаа биш).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Загвар (заавал биш) — үнэ/чанар өөрчлөгдвөл эндээс солино
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── OAuth хамгаалалт ──────────────────────────────────────────────────
# ⚠️⚠️ ЗААВАЛ: `/auth/oauth` нь имэйлээр хэрэглэгч олоод ТҮҮНИЙ токеныг
# буцаадаг. Энэ нууцгүй бол ХЭН Ч admin имэйл бичээд ADMIN эрх авна.
# ⚠️ frontend/.env-ийн OAUTH_SHARED_SECRET-тэй ЯГ ИЖИЛ байх ёстой.
# ⚠️ Үүсгэх: openssl rand -hex 32
OAUTH_SHARED_SECRET=

# ─── n8n → Telegram мэдэгдэл ───────────────────────────────────────────
# ⚠️⚠️ ЭНЭ ХУВЬСАГЧГҮЙ БОЛ TELEGRAM МЭДЭГДЭЛ ЧИМЭЭГҮЙ УНТАРНА.
#    Лог дээр «N8N_WEBHOOK_URL тохируулаагүй» гэж гарна.
#
# ⚠️ Production дээр compose нь `.env.production`-ыг уншдаг —
#    `.env` БИШ. Хоёуланд нь тавих шаардлагатай (dev/prod).
#
# ⚠️ КОНТЕЙНЕРИЙН НЭРЭЭР бич. Гадаад IP (62.238.47.2:5678) БҮҮ
#    ХЭРЭГЛЭ — тэр порт интернэтэд нээлттэй тул хэн ч хуурамч
#    webhook дуудаж болно.
N8N_WEBHOOK_URL=http://digitalger-n8n:5678
# Хуваалцсан нууц (заавал биш, гэхдээ зөвлөнө)
N8N_WEBHOOK_SECRET=

# ─── ИМЭЙЛ (AWS SES) ───────────────────────────────────────────────────
# ⚠️⚠️ ЭДГЭЭРГҮЙ БОЛ БҮХ ИМЭЙЛ ЧИМЭЭГҮЙ УНТАРНА — нууц үг сэргээх,
#    багц идэвхжсэн, түрээсийн баталгаа, хэтэвч цэнэглэлт бүгд явахгүй.
#    Код нь алдаа ШИДДЭГГҮЙ, зөвхөн `failed` гэж логдоно.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
MAIL_FROM=noreply@example.mn

# ─── ВИДЕО CDN (заавал биш, гэхдээ ЗӨВЛӨНӨ) ────────────────────────────
# ⚠️ Байхгүй бол presign руу унана — сайт ажиллана ч Cloudflare кэш
#    ашиглагдахгүй (видео эхлэх 256ms vs 73ms).
VIDEO_CDN_URL=
VIDEO_SIGN_SECRET=

# ─── HLS ХӨРВҮҮЛЭЛТ (заавал биш) ───────────────────────────────────────
# ⚠️ `HLS_THREADS` — ffmpeg-ийн CPU thread. Хоосон бол автомат.
# ⚠️ `X264_PRESET` — veryfast (хурдан, том файл) … slow (удаан, жижиг)
HLS_THREADS=
X264_PRESET=veryfast
