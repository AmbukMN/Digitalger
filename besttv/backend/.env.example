# ── BestTV Backend — ТУСДАА .env (DigitalGer-ээс хамааралгүй) ────────────────
NODE_ENV=development
PORT=4100

# Postgres — БҮРЭН ТУСДАА container (besttv/docker/docker-compose.yml, порт 5434)
DATABASE_URL=postgresql://besttv:besttv_secret@localhost:5434/besttv?schema=public

# Redis — БҮРЭН ТУСДАА container (порт 6380)
REDIS_URL=redis://localhost:6380

# JWT — DigitalGer-ээс ӨӨР secret ашиглана!
JWT_SECRET=change-me-besttv-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-besttv-refresh
JWT_REFRESH_EXPIRES_IN=30d

# Cloudflare R2 — ТУСДАА account, PRIVATE bucket (public URL ХЭРЭГГҮЙ —
# бүх хандалт presigned URL-ээр. R2_PUBLIC_URL зориуд байхгүй!)
# ⚠️ Хоосон орхивол автоматаар ЛОКАЛ ДИСК драйвер ажиллана (storage/ хавтас,
# доорх BACKEND_URL-ээр /media/* serve хийнэ) — R2 бэлэн болмогц энд бөглөнө.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=besttv
R2_ENDPOINT=

# QPay — DigitalGer-ийн merchant-ийг ХАМТРАН ашиглана (утгуудыг хуулна)
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4100/api/payments/qpay/callback
QPAY_WEBHOOK_SECRET=

# TMDB — admin контент import (үнэгүй API key: themoviedb.org)
TMDB_API_KEY=

# OAuth — Google/Facebook Client ID/Secret нь FRONTEND-ийн .env.local-д
# байрлана (NextAuth). Backend зөвхөн frontend-ээс profile хүлээж авах
# нэг endpoint-той (/api/auth/oauth) — энд өөр key шаардлагагүй.

# URLs
FRONTEND_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
CORS_ORIGIN=http://localhost:3100,http://localhost:3101

# R2 тохируулаагүй үед storage/ хавтасны файлыг энэ хаягаар serve хийнэ
# (/media/*). VPS дээр домэйн/IP-ээ тавина (ж: https://api.besttv.mn)
BACKEND_URL=http://localhost:4100
