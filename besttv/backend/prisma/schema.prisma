// BestTV — Prisma schema
// Кино/цуврал стриминг: private R2 + HLS, QPay subscription

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
  GUEST
}

enum TitleType {
  MOVIE
  SERIES
}

/// Киноны хэлний хувилбар — хэрэглэгчид картан дээр шошгоор харагдана.
/// MN  = монгол хэлтэй (дубляж/эх хэл) → 🇲🇳 "Хэл"
/// SUB = хадмал орчуулгатай            → "Хадмал"
enum TitleLanguage {
  MN
  SUB
}

/// Видео HLS хөрвүүлэлтийн төлөв (upload → worker → ready)
enum StreamStatus {
  NONE // видео ороогүй
  UPLOADED // raw R2-д орсон, queue-д хүлээж байна
  PROCESSING // ffmpeg HLS хөрвүүлж байна
  READY // m3u8 бэлэн — тоглуулах боломжтой
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Хэтэвчийн гүйлгээний төрөл
enum WalletTxType {
  TOPUP // QPay-ээр цэнэглэсэн
  ADMIN_CREDIT // Админ нэмсэн
  ADMIN_DEBIT // Админ хассан
  PURCHASE // Багц худалдан авахад зарцуулсан
  REFUND // Буцаалт
  /// ⚠️ WALLET_BONUS урамшууллаар автоматаар нэмэгдсэн бонус.
  /// `ADMIN_CREDIT`-ээс ЗААВАЛ ялгана — эс бөгөөс санхүүгийн тайланд
  /// «админ гараар нэмсэн» мэт харагдаж, урамшууллын өртөг тооцоологдохгүй.
  BONUS
}

// ─── Хэрэглэгч ────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String?
  role         Role    @default(USER)

  // ── Avatar ── OAuth-аас ирсэн URL-ийг ШУУД хадгалахгүй, R2 руу mirror
  // хийж key хадгална (гадны CDN унтарвал avatar эвдрэхээс сэргийлнэ,
  // мөн хэрэглэгчийн R2 private bucket-тэй нийцнэ).
  avatarKey String?

  // ── OAuth ──────────────────────────────────────────────────────────────
  provider      AuthProvider @default(LOCAL)
  googleId      String?      @unique
  facebookId    String?      @unique
  emailVerified Boolean      @default(false) // OAuth-аар ирвэл автоматаар true

  // ── Утасны дугаар (verify.mn MO SMS) ──────────────────────────────────
  /**
   * /**
   * /**
   * /**
   * /**
   * ⚠️ ЗААВАЛ БИШ — хэрэглэгч зөвхөн имэйлээр бүртгүүлж болно.
   * ⚠️ `@unique` — нэвтрэхэд ашиглагддаг тул давхардаж БОЛОХГҮЙ.
   * ⚠️ Хадгалахын ӨМНӨ нормалчилна (8 орон). DigitalGer-т нормалчлал
   * БАЙХГҮЙ тул «99001122» ба «+97699001122» нь ХОЁР өөр хэрэглэгч
   * болох боломжтой байсан — тэр алдааг энд давтахгүй.
   */
  phone         String?   @unique
  /// Баталгаажсан огноо. NULL = баталгаажаагүй (нэвтрэхэд саад БОЛОХГҮЙ)
  phoneVerified DateTime?
  /// Баталгаажуулж буй дугаар — verify хийж байж л `phone` солигдоно
  pendingPhone  String?

  // ⚠️ Зочин (guest) нэвтрэлт БҮРМӨСӨН ХАСАГДСАН — зөвхөн Google/Facebook/
  // имэйл+нууц үгээр нэвтэрнэ. Хуучин зочин бүртгэлүүд DB-д үлдсэн бол
  // isGuest=true хэвээр байх ба нэвтрэх боломжгүй болно.
  isGuest    Boolean @default(false)
  guestToken String? @unique

  /// Хэтэвчийн үлдэгдэл (₮) — QPay-ээр цэнэглэж, багц худалдан авахад зарцуулна
  walletBalance Int @default(0)

  /// Хувийн купонууд (re-engagement имэйлээр олгосон)
  coupons Coupon[]

  /**
   * ⚠️⚠️ МАРКЕТИНГ ТАТГАЛЗАЛ — CAN-SPAM шаардлага.
   * БОДИТ АЛДАА: өмнө нь цуцлалт зөвхөн `Subscriber` хүснэгтэд
   * бичигддэг байсан. Гэтэл `broadcast` нь `audience: 'users'` үед
   * `User`-ээс (isActive+emailVerified) сонгодог тул БҮРТГЭЛТЭЙ
   * хэрэглэгч цуцалсан ч маркетинг имэйл АВСААР байв.
   * ⚠️ Гүйлгээний имэйлд (нууц үг, төлбөр) НӨЛӨӨЛӨХГҮЙ — зөвхөн
   * маркетингийн илгээлтэд.
   */
  marketingOptOut Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
  watchProgress WatchProgress[]
  myList        MyListItem[]
  reviews       Review[]
  walletTxs     WalletTransaction[]

  // Tracking — админ хэрэглэгчийн бүрэн зан төлөвийг харна
  pageViews    PageView[]
  titleEvents  TitleEvent[]
  searchEvents SearchEvent[]
  auditLogs    UserAuditLog[]

  chatConversations    ChatConversation[]
  reviewVotes          ReviewVote[]
  reviewReports        ReviewReport[]
  rentals              Rental[]
  emailOtps            EmailOtp[]
  adminSeens           AdminSeen[]
  passwordResets       PasswordResetToken[]
  sessions             UserSession[]
  /// Ашигласан урамшууллууд (давтан ашиглахаас сэргийлэх + үр дүн хэмжих)
  promotionRedemptions PromotionRedemption[]
  notifications        Notification[]

  @@index([provider])
}

/**
 * НЭВТЭРСЭН ТӨХӨӨРӨМЖ (session).
 * ⚠️⚠️ ЯАГААД ХЭРЭГТЭЙ ВЭ: refresh token нь STATELESS JWT байсан тул
 * нэг эрхээр ХЯЗГААРГҮЙ төхөөрөмж зэрэг үзэж болдог байв — нэг хүн
 * багц авч найз нөхөддөө тараах боломжтой, орлогод шууд нөлөөтэй.
 * Одоо refresh token бүр ЭНД бүртгэгдэнэ. Хязгаар хэтэрвэл хамгийн
 * удаан идэвхгүй байсан session устна (тэр төхөөрөмж дараагийн
 * refresh дээр гарна).
 */
model UserSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * ⚠️ Refresh token-ы SHA-256 хэш — ЦЭВЭР утга ХАДГАЛАХГҮЙ.
   * DB задарсан ч токеныг сэргээж ашиглах боломжгүй.
   */
  tokenHash String @unique

  /**
   * Хэрэглэгчид таниулах — «Chrome · Windows», «Safari · iPhone»
   */
  deviceName String?
  /**
   * Түүхий User-Agent (дэлгэрэнгүй шаардлагатай үед)
   */
  userAgent  String?
  /**
   * ⚠️ Сүүлийн IP — сэжигтэй хандалт шалгахад (бүтэн хадгална)
   */
  ip         String?

  /**
   * ⚠️ Хамгийн удаан идэвхгүйг гаргахад ЭНЭ талбараар эрэмбэлнэ
   */
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, lastUsedAt])
  @@index([expiresAt])
}

/// Хэтэвчийн гүйлгээний бүртгэл — үлдэгдлийн өөрчлөлт бүрийг мөрдөнө (audit).
/// balanceAfter нь гүйлгээний дараах үлдэгдлийн snapshot (тулгахад).
model WalletTransaction {
  id     String       @id @default(cuid())
  userId String
  type   WalletTxType
  amount Int // ₮ — эерэг = нэмэгдсэн, сөрөг = хасагдсан

  balanceAfter Int
  description  String @default("")

  /// TOPUP бол QPay Payment-тэй холбоо; PURCHASE бол Subscription-тэй
  paymentId String?
  planId    String?

  /// ADMIN_CREDIT/ADMIN_DEBIT бол хийсэн админы id
  actorUserId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Контент ──────────────────────────────────────────────────────────────────

/// Кино БА цуврал хоёуланг нэг моделд (type ялгана).
/// MOVIE → videoKey шууд энд; SERIES → Season/Episode-уудад.
model Title {
  id            String    @id @default(cuid())
  type          TitleType
  title         String
  titleEn       String? // EN UI дараа нэмэхэд бэлэн
  slug          String    @unique
  description   String    @default("")
  descriptionEn String?

  // Медиа — бүгд R2 key (private bucket, presign-ээр л хандана)
  posterKey         String? // 2:3 (300x450 хэлбэр)
  backdropKey       String? // 16:9 hero (1920x1080)
  trailerKey        String? // HLS m3u8 key — hero autoplay
  /// ⚠️ YouTube трейлерийн key (ж: "dQw4w9WgXcQ") — TMDB-ээс ирнэ.
  /// `trailerKey`-ЭЭС ТУСДАА байх ёстой: тэр нь манай R2 дээрх HLS зам,
  /// энэ нь гадаад YouTube. Хоёуланг нэг талбарт хийвэл player эвдэрнэ.
  /// Манай HLS трейлер БАЙХГҮЙ үед л энийг тоглуулна (нөөц хувилбар).
  trailerYoutubeKey String?
  videoRawKey       String? // upload хийсэн оригинал (HLS болмогц устгана)
  videoKey          String? // HLS m3u8 key (зөвхөн MOVIE)

  streamStatus    StreamStatus @default(NONE)
  /// HLS хөрвүүлэлтийн явц 0-100 (PROCESSING үед админд харуулна)
  streamProgress  Int          @default(0)
  /// Хөрвүүлэлт эхэлсэн хугацаа — ГАЦСАН ажлыг илрүүлэхэд
  streamStartedAt DateTime?
  /// Амжилтгүй болсон шалтгаан (админд харуулна)
  streamError     String?
  durationSec     Int?

  isPremium Boolean @default(true) // false = үнэгүй, эрхгүй үзнэ

  /// ⚠️ ШИРХЭГЭЭР ТҮРЭЭСЛЭХ үнэ (₮). NULL = сайтын нийтлэг үнэ (Settings.rent).
  /// Хэрэглэгч багц авахгүйгээр ЗӨВХӨН энэ киног түрээслэж үзэж болно.
  rentPrice   Int?
  /// Түрээсийн хугацаа (цаг). NULL = нийтлэг тохиргоо (default 48 цаг).
  rentHours   Int?
  /// false = энэ киног ширхэгээр түрээслүүлэхгүй (зөвхөн багцаар)
  rentEnabled Boolean       @default(true)
  rating      Float?
  ageRating   String? // "16+", "PG-13", "G" гэх мэт
  /// ⚠️ Хэлний хувилбар — картан дээр 🇲🇳 "Хэл" / "Хадмал" шошго болно.
  /// Одоо орсон бүх кино монгол хэлтэй тул анхдагч нь MN.
  language    TitleLanguage @default(MN)
  /// Гарал үүслийн улс — «Солонгос», «Хятад», «АНУ» гэх мэт.
  ///
  /// ⚠️⚠️ ХАЙЛТАД ЗААВАЛ ХЭРЭГТЭЙ: «солонгос цуврал» гэж хайхад
  /// Agent Kim (жинхэнэ солонгос цуврал) ОЛДОХГҮЙ байв — жанр нь
  /// «Шилдэг кино», тайлбарт «солонгос» гэсэн үг огт байхгүй.
  /// TMDB-ээс `production_countries`-оор автоматаар бөглөгдөнө.
  country     String?
  director    String?
  year        Int?
  releaseDate DateTime?
  views       Int           @default(0)
  actors      String[]      @default([]) // хуучин энгийн нэрсийн жагсаалт (backward-compat)
  cast        Json? // [{ name, character, photoKey }] — дэлгэрэнгүй cast
  galleryKeys String[]      @default([]) // нэмэлт screenshot/gallery зургууд (R2 key)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Нүүрийн байрлал/дараалал (IncheTV загвар)
  isBanner         Boolean @default(false) // hero carousel-д гарна
  bannerOrder      Int     @default(0)
  comingSoon       Boolean @default(false)
  comingSoonOrder  Int     @default(0)
  newReleasesOrder Int     @default(0)
  hideFromNew      Boolean @default(false)
  isActive         Boolean @default(true)

  genres         TitleGenre[]
  seasons        Season[]
  watchProgress  WatchProgress[]
  myList         MyListItem[]
  reviews        Review[]
  rentals        Rental[]
  /// ⚠️ Энэ киног ширхэгээр түрээслэх QPay төлбөрүүд (`onDelete: SetNull`
  /// тул кино устсан ч төлбөрийн түүх үлдэнэ)
  rentalPayments Payment[]       @relation("RentalPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Хадмалууд (олон хэл)
  subtitles Subtitle[]

  /// Энэ кинотой холбоотой нийгмийн сүлжээний постууд
  socialPosts SocialPost[]

  /// Видеон дээр BestTV лого шатаах эсэх (зүүн дээд, 10%, 70%)
  watermark Boolean @default(false)

  @@index([type, isActive])
  @@index([isBanner, isActive])
  @@index([comingSoon, isActive])
  /**
   * ⚠️ ЭРЭМБЭЛЭЛТИЙН ИНДЕКСҮҮД — эдгээргүй үед Postgres БҮТЭН СКАН + sort
   * хийдэг байв (77 кинод мэдрэгдэхгүй ч 5000+ болоход секундэд хүрнэ).
   * `views`     → "Их үзсэн" мөр, related (`titles.service.ts`)
   * `createdAt` → каталогийн АНХДАГЧ эрэмбэ (хамгийн их дуудагддаг)
   * `rating`    → "Үнэлгээгээр" шүүлт
   * ⚠️ `isActive`-ийг ЭХЭНД тавьсан — бүх асуулга түүгээр шүүдэг тул
   * composite индекс бүтнээрээ ашиглагдана.
   */
  @@index([isActive, createdAt])
  @@index([isActive, comingSoon, views])
  @@index([isActive, rating])
}

model Genre {
  id       String  @id @default(cuid())
  name     String
  nameEn   String?
  slug     String  @unique
  order    Int     @default(0)
  imageKey String?

  /// Насанд хүрэгчдийн контент — ерөнхий каталог/нүүрэнд ХАРАГДАХГҮЙ,
  /// зөвхөн /adult хуудсанд (нас баталгаажуулсны дараа) гарна.
  isAdult Boolean @default(false)

  titles TitleGenre[]
  plans  PlanGenre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isAdult])
}

/// Олон-олон + жанрын мөр доторх дараалал (админ удирдана)
model TitleGenre {
  titleId String
  genreId String
  order   Int    @default(0)

  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  @@index([genreId, order])
}

model Season {
  id      String  @id @default(cuid())
  titleId String
  number  Int
  name    String?

  /// false = хэрэглэгчид ОГТ харагдахгүй (админ нуусан).
  /// Дата устахгүй — админ талд хэвээр, дахин нээж болно.
  isVisible Boolean @default(true)

  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes Episode[]

  createdAt DateTime @default(now())

  @@unique([titleId, number])
}

model Episode {
  id          String  @id @default(cuid())
  seasonId    String
  number      Int
  name        String?
  description String  @default("")

  videoRawKey     String?
  videoKey        String? // HLS m3u8 key
  posterKey       String?
  durationSec     Int?
  streamStatus    StreamStatus @default(NONE)
  /// HLS хөрвүүлэлтийн явц 0-100 (PROCESSING үед админд харуулна)
  streamProgress  Int          @default(0)
  /// Хөрвүүлэлт эхэлсэн хугацаа — ГАЦСАН ажлыг илрүүлэхэд
  streamStartedAt DateTime?
  /// Амжилтгүй болсон шалтгаан (админд харуулна)
  streamError     String?

  /// true = эрхгүй ч үзэж болно (цувралын эхний анги гэх мэт)
  isFreePreview Boolean @default(false)

  /// false = хэрэглэгчид ОГТ харагдахгүй (админ нуусан).
  /// Улирал нуусан бол доторх бүх анги ч мөн нуугдана.
  isVisible Boolean @default(true)

  season        Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Хадмалууд (олон хэл)
  subtitles Subtitle[]

  /// Видеон дээр BestTV лого шатаах эсэх — ГУРВАН төлөв:
  ///   null  = кинооос ӨВЛӨНӨ (анхдагч)
  ///   true  = энэ ангид ЗААВАЛ тавина (кино унтраасан ч)
  ///   false = энэ ангид ЗААВАЛ тавихгүй (кино асаасан ч)
  /// ⚠️ `Boolean?` байх ЁСТОЙ — `false` анхдагчтай бол «тохируулаагүй»
  /// болон «зориуд унтраасан» хоёрыг ялгах боломжгүй болно.
  watermark Boolean?

  @@unique([seasonId, number])
  /// ⚠️ `video-recovery` cron (10 мин тутам) нь `streamStatus='PROCESSING'`
  /// + `streamStartedAt < cutoff`-ээр шүүдэг. Индексгүй байсан тул анги
  /// олшрох тусам скан удаашрана.
  @@index([streamStatus, streamStartedAt])
}

// ─── Subscription + QPay ──────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  name         String // "Монгол кино багц"
  description  String   @default("")
  price        Int // ₮
  durationDays Int // 30 / 90 / 180 / 365
  features     String[] @default([])
  isActive     Boolean  @default(true)
  order        Int      @default(0)

  /// VIP = БҮХ жанрын контент нээгдэнэ (genres холбоос үл хамааран).
  /// false бол зөвхөн PlanGenre-д холбогдсон жанрууд нээгдэнэ.
  isVip Boolean @default(false)

  /// «Хамгийн ашигтай» тэмдэг — admin-аас удирдана (өмнө нь бүх VIP-д
  /// автоматаар гардаг байсан тул 2 VIP ялгагдахгүй байв). Ихэвчлэн
  /// ганц багцад л тавина — маркетингийн анхаарал татах цэг.
  isBestValue Boolean @default(false)

  /// Badge-ийн ТЕКСТ — admin өөрөө бичнэ (хоосон бол «Хамгийн ашигтай»).
  /// isBestValue=true үед л харагдана.
  badgeText String @default("")

  /// Badge + картын хүрээний ӨНГӨ (HEX, ж: "#ffbe00"). Хоосон бол
  /// системийн premium алтан өнгө. isBestValue=true үед л хэрэглэнэ.
  badgeColor String @default("")

  genres        PlanGenre[]
  subscriptions Subscription[]
  payments      Payment[]
  /// Энэ багцад үйлчлэх урамшууллууд
  promotions    PromotionPlan[]
  /// ⚠️ Энэ багцыг БЭЛЭГ болгон өгдөг урамшууллууд (өөр чиглэл)
  giftedBy      Promotion[]     @relation("PromotionGiftPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Багц ↔ жанрын хандалт. Хэрэглэгч тухайн багцтай бол эдгээр жанрын
/// (аль нэгэнд нь хамаарах) premium контентыг үзэх эрхтэй.
model PlanGenre {
  planId  String
  genreId String

  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([planId, genreId])
  @@index([genreId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  planId    String
  startsAt  DateTime @default(now())
  expiresAt DateTime
  paymentId String?  @unique

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Payment {
  id     String        @id @default(cuid())
  userId String
  /// ⚠️ Хэтэвч цэнэглэх төлбөрт planId БАЙХГҮЙ (null) — багц авахад л заавал
  planId String?
  amount Int
  status PaymentStatus @default(PENDING)

  /// true = хэтэвч цэнэглэх төлбөр (багц худалдан авалт биш)
  isWalletTopup Boolean @default(false)

  /// ⚠️ ШИРХЭГЭЭР ТҮРЭЭСЛЭХ төлбөр — энэ талбар байвал `planId` NULL байна.
  /// Төлбөр амжилттай болмогц `completePayment` нь Rental үүсгэнэ.
  /// ⚠️ `onDelete: SetNull` — кино устсан ч ТӨЛБӨРИЙН ТҮҮХ үлдэх ёстой
  /// (санхүүгийн бүртгэл; Cascade бол мөнгөний мөр алга болно).
  rentalTitleId String?
  rentalTitle   Title?  @relation("RentalPayments", fields: [rentalTitleId], references: [id], onDelete: SetNull)

  /**
   * ─── ДАНСААР ШИЛЖҮҮЛЭХ ───────────────────────────────────────
   * ⚠️ `bankReference` нь ГҮЙЛГЭЭНИЙ УТГА (ж: «BTV-4F2A») — хэрэглэгч
   * шилжүүлэг хийхдээ энэ кодыг бичнэ. Үүнгүйгээр банкны хуулга
   * дээрх мөнгө ХЭНИЙХ болохыг таних БОЛОМЖГҮЙ.
   * ⚠️ Энэ талбар байвал төлбөр нь QPay БИШ, ГАРААР баталгаажна.
   * `status=PENDING` + `bankReference != null` = админ шалгах хүлээлгэнд.
   */
  bankReference    String?      @unique
  /// ⚠️ Аль данс руу шилжүүлэхээр сонгосон (олон данстай тул заавал)
  bankAccountId    String?
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  /// Хэрэглэгч «шилжүүлсэн» товч дарсан мөч (админд хүлээлгийн хугацаа харуулна)
  bankClaimedAt    DateTime?
  /// Админ баталгаажуулсан/татгалзсан мөч
  bankReviewedAt   DateTime?
  /// Татгалзсан бол шалтгаан (хэрэглэгчид имэйлээр очно)
  bankRejectReason String?
  /**
   * ⚠️⚠️ ТӨЛБӨРИЙН БАРИМТ (screenshot) — R2 key.
   * Хэрэглэгч банкны апп-ын зургаа хавсаргана, админ банкны хуулгатай
   * тулгаж ХУРДАН баталгаажуулна. Энэгүйгээр админ хуулга уншиж
   * гүйлгээний утгаар хайх шаардлагатай (удаан, алдаатай).
   */
  bankReceiptKey   String?

  /**
   * ⚠️⚠️ Хэрэглэсэн УРАМШУУЛАЛ (snapshot).
   * `initiate` үед бодсон урамшууллыг ЭНД тэмдэглэнэ, `completePayment`
   * нь үүнийг уншиж бонус хоног/бэлэг багцыг олгоно.
   * Тэмдэглэхгүй бол: төлбөр 5 минут хүлээж байх зуур урамшуулал
   * дуусвал хэрэглэгч хямдруулсан үнээр төлөөд бонусаа АВАХГҮЙ.
   * ⚠️ Relation БИШ зүгээр String — урамшуулал устсан ч төлбөрийн
   * түүх үлдэх ёстой (`PromotionRedemption` нь холбоог хадгална).
   */
  promotionId String?

  couponCode     String? // хэрэглэсэн купон код (лог зорилгоор, snapshot)
  originalAmount Int? // купон хэрэглэхээс өмнөх дvн (хямдрал харуулахад)

  qpayInvoiceId String?   @unique
  qpayQrText    String?
  qpayQrImage   String? // base64 QR
  qpayUrls      Json? // deeplink жагсаалт (банкны app)

  /**
   * ─── BONUM GATEWAY (карт · Apple Pay · Google Pay · WeChat) ────
   * ⚠️ DigitalGer merchant-аар боловсруулагдана — invoice-д брэнд нэр
   * ОГТ явуулахгүй (QPay-тэй ижил зарчим). Webhook нь invoiceId-аар
   * тааруулдаг тул @unique заавал (идемпотент).
   */
  bonumInvoiceId    String? @unique
  /// Bonum hosted checkout хуудасны линк — idempotent дахин ашиглалтад
  bonumFollowUpLink String?
  paidAt        DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan?         @relation(fields: [planId], references: [id])
  subscription Subscription?
  /// ⚠️ Ширхэгээр түрээслэх төлбөрөөр үүссэн түрээс (нэгээс илүүгүй)
  rental       Rental?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  /// ⚠️ `initiateRental`-ийн idempotent хайлтад (userId+rentalTitleId+status)
  @@index([rentalTitleId])
  /// ⚠️ Админы «Дансны төлбөр» жагсаалт — хүлээгдэж буйг эрэмбэлж татна
  @@index([bankClaimedAt])
  /// ⚠️ `reconcilePending` (5 мин тутам) + `expireStalePayments` (цаг тутам)
  /// хоёулаа `status` + `createdAt`-аар шүүдэг. Индексгүй бол Payment
  /// хүснэгтийг БҮТНЭЭР скан хийнэ — мөр өсөх тусам cron удаашрана.
  @@index([status, createdAt])
  /// WARN Admin feed: status=PAID + paidAt DESC, polled every 30s.
  /// Without this it read and sorted the whole payments table.
  @@index([status, paidAt])
}

// ─── Үзэлтийн явц + жагсаалт ─────────────────────────────────────────────────

/// "Үргэлжлүүлэн үзэх" — нэг хэрэглэгч нэг Title-д НЭГ мөр.
/// Цувралд episodeId = одоо үзэж буй анги.
model WatchProgress {
  id          String  @id @default(cuid())
  userId      String
  titleId     String
  episodeId   String?
  positionSec Int     @default(0)
  durationSec Int     @default(0)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([userId, titleId])
  @@index([userId, updatedAt])
}

model MyListItem {
  userId  String
  titleId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, titleId])
}

/// Хэрэглэгчийн үнэлгээ+сэтгэгдэл — нэг хэрэглэгч нэг Title-д НЭГ review
model Review {
  id      String @id @default(cuid())
  userId  String
  titleId String
  rating  Int // 1-10
  comment String @default("")

  /// Спойлер агуулсан — үзээгүй хүнд бүрхэгдэж харагдана
  hasSpoiler Boolean @default(false)

  /// Хариу бичсэн эх сэтгэгдэл. NULL = үндсэн сэтгэгдэл.
  parentId String?
  parent   Review?  @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Review[] @relation("ReviewReplies")

  /// ⚠️ ЯАГААД ЭНЭ ТАЛБАР: SQL-д NULL ≠ NULL тул `@@unique([userId, titleId,
  /// parentId])` нь parentId=NULL үед ОГТ хамгаалдаггүй — нэг хэрэглэгч нэг
  /// кинонд хэдэн ч сэтгэгдэл бичиж чадна. Тиймээс үндсэн сэтгэгдэлд "" (хоосон
  /// мөр), хариунд эх сэтгэгдлийн id-г хадгалж, unique-ыг ҮҮГЭЭР барина.
  parentKey String @default("")

  /// Админ хариулсан эсэх (өнгөөр ялгаж харуулна)
  isStaff Boolean @default(false)

  /// Тохиромжгүй гэж мэдээлэгдсэн тоо — админ шүүнэ
  reportCount Int     @default(0)
  /// Админ нуусан (устгахгүйгээр)
  isHidden    Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  votes   ReviewVote[]
  reports ReviewReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ Нэг хэрэглэгч нэг кинонд нэг л ҮНДСЭН сэтгэгдэл ("" түлхүүрээр).
  /// Хариу нь parentKey=эх id тул олон байж болно (хариу бүр өөр эх сэтгэгдэлд).
  /// Хэрэв нэг хүн нэг эх сэтгэгдэлд ОЛОН хариу бичих шаардлагатай бол энэ
  /// unique саад болно — тиймээс хариунд parentKey-г "reply:<cuid>" гэж өвөрмөц болгоно.
  @@unique([userId, titleId, parentKey])
  @@index([titleId, parentId, createdAt])
  @@index([titleId, createdAt])
  @@index([isHidden, reportCount])
  /// WARN Admin feed sorts ALL reviews by recency; every other
  /// index is titleId-prefixed and therefore unusable here.
  @@index([createdAt])
}

/// Сэтгэгдэлд өгсөн санал (хэрэгтэй / хэрэггүй)
model ReviewVote {
  reviewId String
  userId   String
  /// 1 = хэрэгтэй, -1 = хэрэггүй
  value    Int

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([reviewId, userId])
  @@index([userId])
}

/// Тохиромжгүй сэтгэгдлийн мэдээлэл
model ReviewReport {
  id       String @id @default(cuid())
  reviewId String
  userId   String
  /// spam | offensive | spoiler | other
  reason   String
  note     String @default("")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([createdAt])
}

// ─── Контент маркетинг ────────────────────────────────────────────────────────

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String  @default("Ерөнхий")
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model BlogPost {
  id       String   @id @default(cuid())
  title    String
  slug     String   @unique
  excerpt  String   @default("")
  content  String
  coverKey String?
  tags     String[] @default([])
  author   String?

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

/// Хямдралын купон код — QPay subscription худалдан авалтад ашиглана
model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  discountType DiscountType
  amount       Int // PERCENT бол 1-100, FIXED бол ₮
  maxUses      Int? // null = хязгааргvй
  usedCount    Int          @default(0)
  minPrice     Int          @default(0) // энэ дvнгээс дээш захиалгад л хvчинтэй
  expiresAt    DateTime?
  isActive     Boolean      @default(true)

  /**
   * ⚠️⚠️ ХУВИЙН КУПОН — ЗӨВХӨН энэ хэрэглэгч ашиглана.
   * БОДИТ ЭРСДЭЛ: маркетингийн имэйлд НИЙТЛЭГ код (ж «BUCAJIREE20»)
   * явуулбал нэг хүн Facebook бүлэгт тавьж, мянган хүн ашиглана.
   * Захиалгын бизнест энэ нь шууд алдагдал.
   * NULL = нийтийн код (админ гараар үүсгэсэн). Утгатай бол тэр
   * хэрэглэгчээс өөр хүн ашиглах гэвэл татгалзана.
   */
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Аль автомат урсгалаас үүссэн бэ («winback-3d», «no-purchase-3d»).
   * ⚠️ Давхар илгээхээс сэргийлэх БОЛОН кампанит ажлын үр дүнг
   * хэмжихэд ЗААВАЛ (аль имэйл хэдэн худалдан авалт авчирсан).
   */
  campaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code, isActive])
  /// ⚠️ «Энэ хүнд энэ кампанит ажлын код өгсөн үү» гэдгийг хайхад
  @@index([userId, campaign])
}

// ─── УРАМШУУЛЛЫН СИСТЕМ ──────────────────────────────────────────────────────

/// Урамшууллын төрөл — тус бүр өөр талбар ашиглана (доорх тайлбар).
enum PromotionType {
  /// Нэмэлт ХУГАЦАА — «1 сар аваад 1 сар бэлэг». `bonusDays` ашиглана.
  /// ⚠️ Үнэ ӨӨРЧЛӨГДӨХГҮЙ — орлого бүтэн бичигдэнэ.
  EXTRA_DAYS
  /// ХЯМДРАЛ — хувиар эсвэл тогтмол дүнгээр. `discountType` + `discountValue`.
  DISCOUNT
  /// БЭЛЭГ БАГЦ — өөр багцыг үнэгүй дагалдуулна. `giftPlanId` + `giftDays`.
  GIFT_PLAN
  /// ХЭТЭВЧИЙН БОНУС — цэнэглэхэд нэмэлт мөнгө. `minTopup` + `bonusAmount`.
  WALLET_BONUS
}

/// Урамшуулал — багцын үнэ/хугацаанд нөлөөлөх зарлагдсан урамшуулал.
///
/// ⚠️⚠️ КУПОНООС ЯЛГААТАЙ: купон нь КОД бичиж идэвхжүүлдэг, урамшуулал нь
/// АВТОМАТААР үйлчилнэ (хэрэглэгч юу ч хийхгүй). Тиймээс энэ нь
/// маркетингийн хэрэгсэл — багцын карт дээр харагдаж худалдан авалт өдөөнө.
///
/// ⚠️ Хоёулаа зэрэг үйлчилнэ: эхлээд урамшуулал, дараа нь купон ҮЛДСЭН
/// дүн дээр (30% + 20% = 44%, 50% БИШ). Дэлгэрэнгүйг `promotions.service`.
model Promotion {
  id          String @id @default(cuid())
  /// Хэрэглэгчид харагдах нэр — «Нээлтийн урамшуулал»
  name        String
  /// Багцын карт дээр гарах НЭГ мөр — «30 хоног аваад 60 хоног үзнэ»
  shortText   String @default("")
  /// Дэлгэрэнгүй тайлбар (баннер/модалд)
  description String @default("")

  type PromotionType

  // ─── Төрлөөс хамаарах утгууд ───

  /// EXTRA_DAYS — хэдэн хоног НЭМЖ өгөх вэ
  bonusDays Int?

  /// DISCOUNT — PERCENT (1-100) эсвэл FIXED (₮)
  discountType  DiscountType?
  discountValue Int?

  /// GIFT_PLAN — дагалдах багц
  giftPlanId String?
  giftPlan   Plan?   @relation("PromotionGiftPlan", fields: [giftPlanId], references: [id], onDelete: SetNull)
  /// Бэлэг багцын хугацаа. null бол үндсэн багцтай ИЖИЛ.
  giftDays   Int?

  /// WALLET_BONUS — энэ дүнгээс дээш цэнэглэвэл
  minTopup    Int?
  /// …энэ дүнг НЭМЖ өгнө
  bonusAmount Int?

  // ─── Хамрах хүрээ ───

  /// Хоосон бол БҮХ багцад. Утгатай бол зөвхөн сонгосон багцуудад.
  /// ⚠️ WALLET_BONUS-д хамааралгүй (багцтай холбоогүй).
  plans PromotionPlan[]

  // ─── Хугацаа, хязгаар ───

  startsAt DateTime
  endsAt   DateTime
  isActive Boolean  @default(true)

  /// Нийт хэдэн удаа ашиглаж болох вэ (null = хязгааргүй)
  maxUses    Int?
  usedCount  Int  @default(0)
  /// Нэг хэрэглэгч хэдэн удаа (ихэвчлэн 1)
  maxPerUser Int  @default(1)

  /// ⚠️ true бол ЗӨВХӨН өмнө нь багц аваагүй хэрэглэгчид.
  /// Шинэ хэрэглэгч татах кампанит ажилд.
  newUsersOnly Boolean @default(false)

  /// ⚠️ true бол энэ урамшуулалтай үед КУПОН хэрэглэх боломжгүй.
  /// Хэт их хямдрал өгөхөөс сэргийлнэ.
  blockCoupons Boolean @default(false)

  // ─── Харагдац ───

  /// Кино эгнээний дунд гарах баннер (16:9, R2 key). Хоосон бол баннер гарахгүй.
  bannerKey       String?
  /// Мобайлд өөр зураг (хоосон бол `bannerKey`)
  bannerMobileKey String?

  /// Хэд давхацвал аль нь эхэнд харагдах вэ (бага нь эхэнд)
  order Int @default(0)

  redemptions PromotionRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ Идэвхтэй урамшуулал хайх гол query — хугацаа+идэвх
  @@index([isActive, startsAt, endsAt])
}

/// Урамшуулал ↔ багц. Мөр байхгүй бол урамшуулал БҮХ багцад үйлчилнэ.
model PromotionPlan {
  promotionId String
  planId      String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([promotionId, planId])
  @@index([planId])
}

/// Хэн ямар урамшуулал ашигласан бүртгэл.
///
/// ⚠️⚠️ ХОЁР ЗОРИЛГО:
///   1. `maxPerUser` хязгаарыг шалгах (нэг хүн давтан ашиглахгүй)
///   2. ҮР ДҮНГ ХЭМЖИХ — хэдэн хүн ашигласан, хэдэн төгрөгийн
///      борлуулалт авчирсан, хэдэн хоног үнэгүй өгсөн
model PromotionRedemption {
  id          String  @id @default(cuid())
  promotionId String
  userId      String
  /// Аль төлбөрт үйлчилсэн (хэтэвчийн бонусд ч төлбөр байна)
  ///
  /// ⚠️⚠️ `@unique` — НЭГ ТӨЛБӨРТ НЭГ Л УДАА бонус олгоно.
  /// QPay нь webhook + polling + reconcile cron ГУРВАН замаар зэрэг
  /// ажилладаг. `completePayment`-ийн атомар claim нэг төлбөрийг
  /// хамгаална, гэхдээ `adminMarkPaid` (FAILED→PAID) дахин дуудвал
  /// бонус хоног + бэлэг багц ДАХИН олгогдоно.
  /// `Rental.paymentId @unique` яг ижил шалтгаанаар тавигдсан.
  paymentId   String? @unique

  /// ⚠️ SNAPSHOT — урамшуулал дараа засагдсан ч түүх ҮНЭН үлдэнэ
  /// Хэрэглэгчид ХЭДЭН ТӨГРӨГИЙН ашиг өгсөн (хямдрал/бонус)
  valueGiven Int @default(0)
  /// Хэдэн хоног НЭМЖ өгсөн (EXTRA_DAYS/GIFT_PLAN)
  daysGiven  Int @default(0)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// ⚠️ `maxPerUser` шалгалтын гол index
  @@index([promotionId, userId])
  @@index([userId])
}

// ─── ДАНСААР ТӨЛӨХ: ОЛОН ДАНС ────────────────────────────────────────────────

/// Байгууллагын банкны данс. Хэрэглэгч аль нэгийг сонгож шилжүүлнэ.
///
/// ⚠️⚠️ Өмнө нь `Settings` key/value дотор НЭГ данс байсан нь хангалтгүй:
/// хэрэглэгч ӨӨРИЙН банкнаас шилжүүлэхэд шимтгэлгүй/шуурхай байдаг тул
/// 2-3 банкны данс өгөх нь хөрвөлтийг шууд нэмэгдүүлнэ.
model BankAccount {
  id String @id @default(cuid())

  /// Банкны нэр — «Хаан банк»
  bankName String
  /// ⚠️ Логотой бол хэрэглэгч дансаа НЭГ ХАРЦААР олно (текст уншихгүй).
  /// R2 key; хоосон бол зөвхөн нэр харагдана.
  logoKey  String?

  /// Дотоод дансны дугаар — «5020959308»
  accountNumber String
  /// ⚠️ IBAN нь ТУСДАА талбар — «MN160005005020959308».
  /// Дансны дугаартай нэг мөрөнд нийлүүлбэл хэрэглэгч алийг нь
  /// хуулахаа мэдэхгүй (хэрэглэгчийн скриншот дээр яг тэр асуудал).
  iban          String?
  accountName   String

  isActive Boolean @default(true)
  /// Жагсаалтад харагдах дараалал (бага нь эхэнд)
  order    Int     @default(0)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ─── ХЭРЭГЛЭГЧИЙН МЭДЭГДЭЛ ───────────────────────────────────────────────────

enum NotificationType {
  /// Дансны төлбөр баталгаажсан
  PAYMENT_APPROVED
  /// Дансны төлбөр татгалзсан
  PAYMENT_REJECTED
  /// Багц идэвхжсэн
  PLAN_ACTIVATED
  /// Багц дуусахад ойртсон
  PLAN_EXPIRING
  /// Хэтэвч цэнэглэгдсэн
  WALLET_TOPUP
  /// Урамшуулал олгогдсон
  PROMOTION_APPLIED
  /// Ерөнхий мэдээлэл (админаас)
  INFO
}

/// Хэрэглэгчид харагдах мэдэгдэл (хонхны дүрс дээр).
///
/// ⚠️⚠️ ЯАГААД ХЭРЭГТЭЙ ВЭ: дансаар төлсөн хэрэглэгч «баталгаажсан уу?»
/// гэдгээ мэдэхгүй хүлээнэ. Имэйл нь хоцордог/спамд ордог. Сайт дээр
/// шууд харагдах мэдэгдэл нь дэмжлэгийн дуудлагыг эрс багасгана.
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title String
  body  String

  /// Дарахад очих зам — «/profile?tab=orders»
  link String?

  /// ⚠️ Уншсан эсэх — уншаагүйн тоог хонхон дээр улаанаар харуулна
  readAt DateTime?

  createdAt DateTime @default(now())

  /// ⚠️ Уншаагүйг эхэнд, шинийг дээр нь — жагсаалтын гол query
  @@index([userId, readAt, createdAt])
}

/// Статик хуудас — Үйлчилгээний нөхцөл, Нууцлалын бодлого, Дата устгах хүсэлт
/// гэх мэт. Админаас агуулга+SEO-г бүрэн удирдана (DigitalGer-ийн Pages жишиг).
model Page {
  id      String @id @default(cuid())
  slug    String @unique // "terms" | "privacy" | "data-deletion" | "about"
  title   String
  content String @default("") // HTML/Markdown-той rich text

  metaTitle       String?
  metaDescription String?
  ogImageKey      String?

  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ─── Тохиргоо ─────────────────────────────────────────────────────────────────

model Settings {
  key   String @id
  value Json

  updatedAt DateTime @updatedAt
}

/// Нүүр хуудасны ДУНД байрлах сурталчилгааны баннер.
///
/// ⚠️ `Title.isBanner` (hero carousel)-ЭЭС ТУСДАА. Тэр нь кинонд
/// холбогдсон, дээд талын том carousel. Энэ нь жанрын эгнээнүүдийн
/// ДУНД орох бие даасан зурвас — кино биш ямар ч зүйл сурталчилж
/// болно (багц, урамшуулал, гадаад холбоос).
model HomeBanner {
  id       String @id @default(cuid())
  /// Баннер дээр гарах гарчиг (заавал биш — зөвхөн зурагтай ч болно)
  title    String @default("")
  subtitle String @default("")

  /// 16:9 өргөн зураг — R2 key
  imageKey       String
  /// ⚠️ Мобайлд өөр зураг (заавал биш). Хоосон бол `imageKey`-г
  /// хэрэглэнэ — өргөн зураг утсан дээр хэт нарийн харагддаг.
  mobileImageKey String?

  /// Товчны текст. Хоосон бол товч ХАРАГДАХГҮЙ (зөвхөн зураг).
  ctaText String @default("")
  /// Дарахад очих зам (`/movie/slug`, `/pricing`, гадаад URL)
  ctaHref String @default("")

  /**
   * ⚠️ БАЙРЛАЛ — хэддэх жанрын эгнээний ДАРАА орох вэ.
   * 0 = хамгийн дээр, 2 = 2 эгнээний дараа. Нүүрэнд 15 эгнээ гардаг
   * тул үүнээс их утга нь баннерыг ХЭЗЭЭ Ч харуулахгүй болно.
   */
  position Int @default(2)
  /// Хэд хэдэн баннер ижил `position`-той бол энэ эрэмбээр
  order    Int @default(0)

  isActive Boolean   @default(true)
  /// ⚠️ Хугацаат урамшуулалд — NULL бол хязгааргүй
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position, order])
}

// ─── Tracking / Analytics ────────────────────────────────────────────────────
// ⚠️ Fail-open хэв маяг: titleId/episodeId-д хатуу FK ТАВИХГҮЙ — устсан эсвэл
// хуурамч id-аас болж sendBeacon-ий insert унахаас сэргийлнэ. Зөвхөн userId л
// бодит User-тэй холбогдоно (onDelete: SetNull — хэрэглэгч устахад лог үлдэнэ).

/// Хэрэглэгч аль хуудсаар зочилсон
model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device    String? // mobile | desktop | tablet
  referrer  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

/// Кино/цуврал дээрх үйлдэл — юу үзсэн, юу дуусгасныг харна
model TitleEvent {
  id          String   @id @default(cuid())
  /// view | play | progress | complete | mylist_add | mylist_remove
  type        String
  titleId     String
  titleSlug   String?
  titleName   String? // хожим Title устсан ч түүхэнд нэр үлдэнэ
  episodeId   String?
  /// progress/complete үед — хаана хүртэл үзсэн
  positionSec Int?
  durationSec Int?
  sessionId   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device      String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([titleId, type, createdAt])
  @@index([type, createdAt])
}

/// Хайлтын түүх — хэрэглэгч юу хайж байсныг админ харна
model SearchEvent {
  id        String   @id @default(cuid())
  query     String
  results   Int      @default(0)
  sessionId String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([query, createdAt])
  @@index([createdAt])
}

/// Аккаунтын өөрчлөлт/нэвтрэлтийн түүх
model UserAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// login | register | oauth_login | logout | password | email | name | avatar
  /// | role | blocked | wallet_credit | wallet_debit | plan_granted
  field     String
  oldValue  String?
  newValue  String?
  /// self | admin | system
  actor     String
  actorId   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([field, createdAt])
}

// ─── Чат (вэб AI туслах + админ гар хариулт) ─────────────────────────────────
// Урсгал: frontend → n8n webhook → n8n нь AI хариу + /chat/ingest-ээр энд бичнэ.
// ⚠️ AI-ийн ЯРИАНЫ САНАХ ОЙ энд БИШ — n8n-ий Postgres memory-д. Энд зөвхөн лог.

model ChatConversation {
  id        String  @id @default(cuid())
  /// web (одоогоор зөвхөн вэб; ирээдүйд facebook/instagram)
  channel   String  @default("web")
  /// frontend localStorage-оос ирнэ (web_xxx) — upsert-ийн түлхүүр
  sessionId String  @unique
  /// Нэвтэрсэн хэрэглэгчтэй холбогдвол (нэвтрэх үед backfill)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  userEmail String?
  /// FB/IG профайл зураг (Graph API `profile_pic`).
  /// ⚠️ URL нь ХУГАЦААТАЙ (signed, хэдэн долоо хоногт үхнэ) — тиймээс
  /// мессеж ирэх бүрд дахин бичнэ. Идэвхгүй ярианд зураг үхэхэд
  /// Avatar компонент нэрийн эхний үсэг рүү унана (graceful).
  userImage String?

  lastMessageAt   DateTime @default(now())
  /// Хэрэглэгч бичсэн, админ хараагүй
  adminUnread     Boolean  @default(false)
  /// Админ гар аргаар авсан — AI хариулахаа болино
  handedOff       Boolean  @default(false)
  /// Админ бичсэн, хэрэглэгч хараагүй
  userUnreadCount Int      @default(0)

  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([adminUnread, lastMessageAt])
  @@index([channel, lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant | admin
  role           String
  text           String           @db.Text
  /// Санал болгосон кино/цуврал: [{id,title,slug,posterUrl,url,year,rating}]
  titles         Json?
  /// ⚠️⚠️ Холбоосын OG карт: {url,title,description,image,siteName}
  ///
  /// Хариунд besttv.us линк орвол backend нь OG-г НЭГ УДАА татаад энд
  /// хадгална. Вэб чат, админ панель, FB/IG гурвуулаа ЭНЭ НЭГ эх
  /// сурвалжаас уншина — тус тусад нь татвал зөрөх, давхардах эрсдэлтэй.
  ///
  /// Ингэснээр админ панель нь хэрэглэгч LIVE дээр ЯГ ЮУ ХАРСНЫГ
  /// тэр чигээр нь харуулна.
  linkPreview    Json?
  /// FB/IG-ээс ирсэн хавсралтын R2 key (баримтын зураг, файл).
  /// ⚠️ Meta-гийн CDN URL нь ХУГАЦААТАЙ тул R2 руу ХУУЛНА — эс бөгөөс
  /// дансаар төлсөн баримт хэдэн өдрийн дараа алга болж, маргаан
  /// гарахад нотлох баримтгүй үлдэнэ.
  attachmentKey  String?
  /// image | file | video
  attachmentType String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  /// WARN Admin feed: role=user + createdAt DESC. The only index
  /// starts with conversationId, so it could not serve this sort.
  @@index([role, createdAt])
}

/// Кино ширхэгээр түрээслэх — багц авахгүйгээр нэг киног хугацаатай үзэх.
///
/// ⚠️ Эрх шалгах дараалал: (1) үнэгүй кино → (2) идэвхтэй багц → (3) идэвхтэй
/// түрээс. Аль нэг нь таарвал үзнэ.
model Rental {
  id      String @id @default(cuid())
  userId  String
  titleId String

  /// Төлсөн дүн (₮) — түүхэнд үлдэнэ (үнэ хожим өөрчлөгдсөн ч)
  amount    Int
  /**
   * Холбогдох төлбөр (QPay эсвэл хэтэвч).
   * ⚠️ `@unique` — нэг төлбөр ЗӨВХӨН нэг түрээс үүсгэнэ. Webhook давхар
   * ирвэл (QPay callback + polling + reconcile зэрэг ажилладаг) хоёр
   * дахь `create` DB түвшинд унана → хэрэглэгч 2 удаа төлөхгүй.
   */
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  /// Хүчинтэй хугацаа дуусах — энэ хүртэл үзнэ
  expiresAt DateTime
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  /// Идэвхтэй түрээс хайхад (userId + titleId + хугацаа)
  @@index([userId, titleId, expiresAt])
  @@index([titleId, createdAt])
  @@index([expiresAt])
}

// ─── Имэйл систем ────────────────────────────────────────────────────────────

/// Имэйл баталгаажуулах / имэйл солих OTP код.
/// ⚠️ Код нь HASH-лагдаж хадгалагдана (задарсан DB-ээс код уншигдахгүй).
model EmailOtp {
  id        String    @id @default(cuid())
  userId    String
  /// Аль имэйл рүү илгээсэн (имэйл солиход ШИНЭ имэйл)
  email     String
  codeHash  String
  /// verify | change — юуны төлөө илгээснийг ялгана
  purpose   String    @default("verify")
  attempts  Int       @default(0)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

/// Нууц үг сэргээх линкийн токен.
///
/// ⚠️ ЯАГААД `EmailOtp`-ыг ДАХИН АШИГЛААГҮЙ ВЭ:
///   1. EmailOtp = 6 оронтой КОД, 10 мин, хэрэглэгч ГАРААР бичдэг.
///      Энд = 32 байт санамсаргүй ТОКЕН, 1 цаг, ЛИНКЭЭР ирнэ.
///   2. Шалгалт нь өөр: OTP-г `userId`-аар олдог (нэвтэрсэн хэрэглэгч),
///      энд хэрэглэгч НЭВТРЭЭГҮЙ тул токеноор л олох ёстой →
///      `tokenHash` дээр UNIQUE индекс хэрэгтэй.
///   3. Хутгавал "имэйл баталгаажуулах код нууц үг солиход ажиллана"
///      гэсэн эрхийн давхцал (privilege confusion) үүсэх эрсдэлтэй.
///
/// ⚠️ `tokenHash` — түүхий токеныг ХЭЗЭЭ Ч хадгалахгүй. DB задарсан ч
/// халдлагчид линк сэргээх боломжгүй (SHA-256, урвуулж болохгүй).
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String

  /// SHA-256(token) — түүхий токен зөвхөн имэйл дэх линкэнд л байна
  tokenHash String @unique

  /// Хүсэлт ирсэн IP/browser — сэжигтэй үйлдэл мөрдөхөд
  ip        String?
  userAgent String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Bounce/complaint ирсэн хаягууд — дахин илгээхгүй (SES reputation хамгаална).
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  /// bounce | complaint | manual
  reason    String
  subType   String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([reason, createdAt])
}

/// Илгээсэн имэйл бүрийн лог — админ хяналт, дахин илгээх шалгалт.
/**
 * Имэйл НЭЭЛТ бүрийн мөр (1×1 pixel-ээс).
 * ⚠️⚠️ ЯАГААД ТУСДАА ХҮСНЭГТ ВЭ — EmailLog.openCount ХАНГАЛТГҮЙ:
 * • НЭГ хүн олон удаа нээхийг ЯЛГАХ («unique openers») боломжгүй
 * • Хэзээ, хэдэн удаа нээснийг цаг хугацааны хэлхээгээр харах
 * • Нэг имэйлийг ОЛОН хүн дамжуулан нээхийг барих
 * ⚠️ `logId` нь FK БИШ (зориуд): лог устсан ч нээлтийн статистик
 * үлдэнэ. DigitalGer дээр ч ижил зарчим.
 */
model EmailOpen {
  id String @id @default(cuid())

  /// Хэн нээв
  email    String
  /// Аль имэйлийнх — EmailLog.id (FK биш, лог устахад статистик үлдэнэ)
  logId    String?
  /// Загварын нэр (welcome | marketing | rental ...) — кампанит ажлын түлхүүр
  template String

  /// ⚠️ Ямар төхөөрөмжөөс нээв — Gmail proxy эсэхийг ялгахад
  userAgent String?

  openedAt DateTime @default(now())

  @@index([template, openedAt])
  @@index([email, template])
  @@index([logId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  /// welcome | verify | payment | subscription | rental | expiring |
  /// rental-expiring | password-reset | password-changed | marketing
  template  String
  /// sent | failed | suppressed
  status    String   @default("sent")
  error     String?
  userId    String?

  /// ⚠️ BULK / КАМПАНИТ ИЛГЭЭЛТИЙН БҮЛЭГ.
  /// Нэг bulk илгээлт (кино реклам, broadcast) доторх БҮХ имэйл ижил
  /// batchId-тай. Admin-д «фолдер» болгож бүлэглэхэд ашиглана — 500
  /// имэйлийг тусдаа мөр болгож пагинаци тэсэлгэхгүй.
  /// Ганц (transactional) имэйлд null — жагсаалтад дангаараа харагдана.
  batchId    String?
  /// Bulk бүлгийн ГАРЧИГ (жишээ: «Кино реклам: Амьдрал чамд жүрж өгөхөд»)
  batchLabel String?
  /**
   * ⚠️⚠️ ЯГ ИЛГЭЭСЭН HTML — админ бодит имэйлийг ХАРНА.
   *
   * Өмнө нь зөвхөн `to/subject/template` хадгалагддаг байсан тул
   * админ хэрэглэгчид ЯГ ЮУ очсоныг харах боломжгүй, гомдол
   * шалгахад «магадгүй ийм байсан» гэж таамаглах шаардлагатай байв.
   *
   * ⚠️ Нээлтийн pixel НЭМЭГДСЭН хувилбарыг хадгална — хэрэглэгчийн
   * хүлээн авсантай ЯГ ИЖИЛ.
   */
  html      String?  @db.Text
  createdAt DateTime @default(now())

  // ─── ХҮРГЭЛТ / НЭЭЛТИЙН ХЯНАЛТ ──────────────────────────────────────────
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * ⚠️⚠️ SES-ийн MessageId — SNS үйл явдлыг ЭНЭ мөртэй холбох ЦОРЫН ГАНЦ түлхүүр.
   * Өмнө нь `this.ses.send(...)` хариуг хувьсагчид ОГТ авдаггүй байсан тул
   * MessageId алдагдаж, ирсэн үйл явдлыг аль имэйлийнх болохыг мэдэх
   * боломжгүй байв. Одоо хадгална.
   * ⚠️ `@unique` — SNS нь нэг үйл явдлыг ОЛОН УДАА илгээж болно
   * (at-least-once). Давхардлыг DB түвшинд хаана.
   */
  messageId String? @unique

  /**
   * SNS-ээс «Delivery» ирсэн мөч — хүлээн авагчийн сервер хүлээж авав
   */
  deliveredAt DateTime?

  /**
   * ⚠️ Анх НЭЭСЭН мөч. Дараагийн нээлтэд ДАРЖ БИЧИХГҮЙ — эхнийх нь
   * хамгийн үнэ цэнэтэй хэмжүүр (хэр хурдан нээв).
   */
  openedAt DateTime?

  /**
   * Хэдэн удаа нээсэн (нэг хүн олон удаа нээж болно)
   */
  openCount Int @default(0)

  /**
   * Имэйл доторх холбоос анх дарсан мөч
   */
  clickedAt DateTime?

  /**
   * Хэдэн удаа дарсан
   */
  clickCount Int @default(0)

  /**
   * Буцаагдсан/гомдол ирсэн мөч. `bounce` = хаяг байхгүй,
   * `complaint` = спам гэж мэдээлсэн.
   */
  bouncedAt  DateTime?
  bounceType String?

  @@index([template, createdAt])
  @@index([to, createdAt])
  @@index([status, createdAt])
  /// ⚠️ Bulk бүлэглэлт — batchId-ээр групплэх/тоолоход хурдан байх
  @@index([batchId, createdAt])
  /**
   * ⚠️ Нээлтийн статистик — «нээгээгүй» шүүлтэд ч хэрэгтэй
   */
  @@index([openedAt])
  @@index([template, openedAt])
}

/// Имэйл цуглуулга (мэдээллийн товхимол).
/// ⚠️ Хэрэглэгч бүртгүүлэхэд ч энд автоматаар нэмэгдэнэ (source=register).
model Subscriber {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  /// homepage | footer | register | checkout | admin | import
  source      String?
  status      SubscriberStatus @default(ACTIVE)
  tags        String[]         @default([])
  /// Нэвтэрсэн хэрэглэгчтэй холбоотой бол
  userId      String?
  lastEmailAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([source])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

/// Админы sidebar "уншаагүй" badge — хэсэг бүрийг сүүлд харсан огноо.
/// Badge тоо = тухайн хэсгийн createdAt > lastSeenAt.
/// ⚠️ Хэсэгт орж харахад lastSeenAt=now() → badge цэвэрлэгдэнэ (Gmail загвар).
model AdminSeen {
  id      String @id @default(cuid())
  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// users | payments | reviews | chat | subscribers | email-issues | rentals
  section String

  lastSeenAt DateTime @default(now())

  @@unique([adminId, section])
  @@index([adminId])
}

// ─── FACEBOOK → INSTAGRAM ХӨНДЛӨН НИЙТЛЭЛ ────────────────────────────────────

/// Хөндлөн нийтлэлийн төлөв.
enum CrosspostStatus {
  /// Дараалалд орсон, хүлээж байна
  QUEUED
  /// Медиаг R2 руу хуулж, IG контейнер үүсгэж байна
  PROCESSING
  /// IG дээр амжилттай нийтлэгдсэн
  PUBLISHED
  /// Алдаа гарсан — `error` талбарт шалтгаан
  FAILED
  /// IG-д техникийн хувьд боломжгүй (текст/линк пост)
  SKIPPED
}

/**
 * Facebook постыг Instagram руу шилжүүлсэн бүртгэл.
 * ⚠️⚠️ `fbPostId @unique` нь ХАМГИЙН ЧУХАЛ хамгаалалт — нэг FB постыг
 * ХОЁР УДАА нийтлэхээс DB түвшинд сэргийлнэ. Админ хоёр таб нээгээд
 * зэрэг «Шилжүүлэх» дарвал, эсвэл дараалал давхар ажиллавал хоёр дахь
 * оролдлого DB дээр унана — IG дээр давхардсан пост ГАРАХГҮЙ.
 * ⚠️ Амжилтгүй бичлэгийг УСТГАХГҮЙ — админ яагаад болоогүйг харах ёстой.
 * Дахин оролдохдоо мөрийг шинэчилнэ (шинээр үүсгэхгүй).
 */
model SocialCrosspost {
  id String @id @default(cuid())

  /// Facebook постын ID («108103720808038_1679088697555702»)
  fbPostId   String   @unique
  /// FB постын текст — админд харуулах, IG caption болно
  message    String   @default("")
  /// FB дээр нийтлэгдсэн огноо (эрэмбэлэхэд)
  fbPostedAt DateTime

  /// IMAGE | VIDEO | CAROUSEL | TEXT | LINK — анги
  kind   String
  status CrosspostStatus @default(QUEUED)

  /// Instagram дээрх постын ID (амжилттай бол)
  igMediaId String?
  /// IG рүү нийтэлсэн caption (админ засварласан байж болно)
  caption   String?

  /**
   * ⚠️ Алдааны ШАЛТГААН — хэрэглэгчийн ойлгох хэлээр. Meta-гийн
   * англи алдааг шууд харуулбал админ юу хийхээ мэдэхгүй.
   */
  error String?

  /// R2 руу хуулсан медиа key-үүд (цэвэрлэхэд + дахин оролдоход)
  mediaKeys String[]

  /// Хэдэн удаа оролдсон — 3-аас хэтэрвэл автоматаар зогсоно
  attempts Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([fbPostedAt])
}

// ─── НИЙТЛЭЛ ТОВЛОГЧ (FB + IG) ──────────────────────────────────────────────
//
// ⚠️⚠️ `SocialCrosspost`-ООС ТУСДАА. Тэр нь FB дээр АЛЬ ХЭДИЙН байгаа
// постыг IG руу хуулдаг (нэг чиглэлт). Энэ нь админ панелаас ШИНЭЭР
// пост зохиож, хоёр суваг руу товлодог. Хоёуланг нэг модел болгох нь
// ажиллаж байгаа хуулбарлагчийг эвдэх эрсдэлтэй.

enum SocialChannel {
  FACEBOOK
  INSTAGRAM
}

/**
 * Хуваарийн ТӨРӨЛ — Buffer-ийн гол механик.
 *
 * ⚠️⚠️ ЯАГААД ЯЛГАХ ШААРДЛАГАТАЙ ВЭ: slot бол «мөр» биш, ДАВТАГДАХ
 * ЦАГИЙН ХУВААРЬ. Админ хуваариа өөрчлөхөд (жишээ: 19:00-ыг 20:00
 * болгох) `NEXT_AVAILABLE` постууд ШИНЭ цаг руу автоматаар шилжинэ,
 * харин `CUSTOM` постууд ХӨДӨЛДӨГГҮЙ.
 *
 * Хоёуланг нэг талбарт хадгалбал энэ зан төлөвийг гаргах боломжгүй.
 */
enum SocialScheduleKind {
  /// Дараагийн сул slot — хуваарь өөрчлөгдөхөд ДАГАЖ шилжинэ
  NEXT_AVAILABLE
  /// Админ гараар сонгосон яг цаг — ХӨДӨЛӨХГҮЙ
  CUSTOM
}

enum SocialPostStatus {
  /// Зохиож байгаа — хаана ч илгээгдэхгүй
  DRAFT
  /// Товлогдсон — `scheduledAt` болоход cron авна
  SCHEDULED
  /// Сувгууд руу илгээгдэж байна
  PUBLISHING
  /// БҮХ суваг амжилттай
  PUBLISHED
  /// ЗАРИМ суваг амжилттай (хэсэгчилсэн)
  PARTIAL
  /// БҮХ суваг амжилтгүй
  FAILED
  /// Админ цуцалсан
  CANCELLED
}

enum SocialTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  /// Энэ сувагт техникийн хувьд боломжгүй (ж: IG-д медиагүй)
  SKIPPED
}

model SocialPost {
  id String @id @default(cuid())

  status SocialPostStatus @default(DRAFT)

  /// Үндсэн текст — суваг тус бүр өөрийн хувилбартай байж болно
  body String @default("")

  /// R2 медиа key-үүд (зураг/видео). IG-д ЗААВАЛ нэг байх ёстой.
  mediaKeys String[]

  /**
   * ⚠️ Хэзээ нийтлэх (UTC). `null` = draft.
   * Cron минут тутам `scheduledAt <= now` бөгөөд `SCHEDULED`-ыг авна.
   */
  scheduledAt DateTime?

  /**
   * ⚠️ Хуваарь өөрчлөгдөхөд энэ пост ШИЛЖИХ эсэх (дээрх enum-ийн
   * тайлбарыг үз). `NEXT_AVAILABLE` бол дахин хуваарилагдана.
   */
  scheduleKind SocialScheduleKind @default(CUSTOM)

  /// Кинотой холбоо — «шинэ кино → автомат draft» боломжид
  titleId String?
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: SetNull)

  /**
   * ДАХИН НИЙТЛЭХ (evergreen). `null` = давтахгүй.
   * `{ gap: 2, freq: 'WEEK', expireCount: 5, done: 1 }`
   */
  recycle Json?

  /// Хэн үүсгэсэн (аудит)
  createdById String?

  targets SocialPostTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ Cron-ий гол query — индексгүй бол минут тутам бүтэн скан
  @@index([status, scheduledAt])
  @@index([createdAt])
}

/**
 * Суваг тус бүрийн ТУСДАА төлөв.
 * ⚠️⚠️ ЯАГААД ТУСДАА ХҮСНЭГТ ВЭ: нэг суваг унасан нь бусдыг зогсоох
 * ёсгүй бөгөөс дахин оролдохдоо ЗӨВХӨН унасан сувгийг илгээх ёстой.
 * Нэг мөрөнд хоёуланг хадгалбал retry үед FB дээр ДАВХАР пост үүснэ
 * (салбарын судалгаагаар хамгийн түгээмэл алдаа).
 */
model SocialPostTarget {
  id String @id @default(cuid())

  postId String
  post   SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  channel SocialChannel
  status  SocialTargetStatus @default(PENDING)

  /// Энэ сувагт зориулсан текст. `null` = `post.body` ашиглана.
  caption String?

  /// Нийтлэгдсэн постын ID (fb_post_id / ig_media_id)
  externalId String?

  /// Алдааны шалтгаан — МОНГОЛООР (админ юу хийхээ мэдэх ёстой)
  error String?

  attempts    Int       @default(0)
  publishedAt DateTime?

  /**
   * ⚠️⚠️ IDEMPOTENCY — retry үед ДАВХАР нийтлэхээс сэргийлнэ.
   * Нийтлэх ажил эхлэхэд үүснэ. Сүлжээ тасарч хариу ирээгүй ч
   * пост үүссэн байж болно — дараагийн оролдлогод энэ түлхүүрээр
   * шалгаж давхардлыг барина.
   */
  idempotencyKey String? @unique

  /**
   * ⚠️⚠️ IG CONTAINER ID — retry-ийн ГОЛ ХАМГААЛАЛТ.
   *
   * Instagram-д нийтлэх нь 2 алхам: container үүсгэх → publish.
   * Publish алхам сүлжээний алдаагаар унавал ДАХИН CONTAINER
   * ҮҮСГЭХ ЁСГҮЙ — нэг container хоёр удаа publish хийгддэггүй тул
   * хуучныг дахин ашиглах нь давхардлаас хамгаална (Meta-гийн
   * зөвлөмж: idempotency key байхгүй тул `creation_id` нь орлоно).
   *
   * ⚠️ Container 24 цаг хүчинтэй. Хэтэрвэл `EXPIRED` болох тул
   * шинээр үүсгэнэ — `igContainerAt`-аар шалгана.
   */
  igContainerId String?
  igContainerAt DateTime?

  /**
   * ⚠️ FB ӨӨРӨӨ ТОВЛОСОН эсэх.
   *
   * Facebook нь `published=false` + `scheduled_publish_time`-аар
   * ӨӨРИЙН ТАЛД товлодог (10 мин – 30 хоног). Тэр үед бидний cron
   * нийтлэх ШААРДЛАГАГҮЙ — Meta автоматаар хийнэ.
   *
   * ⚠️ IG-д ийм боломж БАЙХГҮЙ тул хоёр суваг ӨӨР замаар явна.
   */
  fbNativeScheduled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Нэг постод нэг суваг ЗӨВХӨН НЭГ УДАА
  @@unique([postId, channel])
  @@index([status])
}

/**
 * ДАРААЛЛЫН SLOT (Buffer-ийн загвар).
 * Долоо хоногийн тогтмол цагууд. Пост нэмэхэд «дараагийн сул slot»
 * руу автоматаар орно — админ огноо сонгох шаардлагагүй.
 */
model SocialSlot {
  id String @id @default(cuid())

  channel SocialChannel
  /// 0 = Ням … 6 = Бямба (JS `getDay()`-тэй ижил)
  weekday Int
  /// "19:00" — Улаанбаатарын цагаар
  time    String

  createdAt DateTime @default(now())

  @@unique([channel, weekday, time])
  @@index([channel])
}

/**
 * Сувгийн тохиргоо — түр зогсоох (pause).
 *
 * ⚠️ Buffer-т pause нь СУВАГ ТУС БҮРЭЭР хийгддэг (бөөнөөр биш).
 * Зогсоосон үед товлосон постууд ЯВАХГҮЙ, дараалалдаа хэвээр
 * үлдэнэ — сэргээхэд анхны дарааллаараа үргэлжилнэ.
 *
 * ⚠️ Buffer дээр pause нь календарь дээр ХАРАГДДАГГҮЙ (тэдний сул
 * тал). Бид админд ТОДООР харуулна — эс бөгөөс «яагаад пост
 * явахгүй байна» гэж удаан хайна.
 */
model SocialChannelSetting {
  channel SocialChannel @id

  /// true = товлосон пост явахгүй (дараалалд хэвээр үлдэнэ)
  paused Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ─── RE-ENGAGEMENT / АМЬДРАЛЫН МӨЧЛӨГИЙН ИМЭЙЛ ───────────────────────────────

/**
 * Автомат имэйлийн ЗАГВАР — админ панелаас засварлана.
 * ⚠️⚠️ ЯАГААД DB-Д ХАДГАЛАХ ВЭ: DigitalGer дээр бүх загвар кодод
 * шигдсэн байсан тул «сайн уу»-г «Сайн байна уу» болгоход ч DEPLOY
 * шаардлагатай байв. Маркетингийн текстийг маркетингийн хүн засах
 * ёстой, программист биш.
 * ⚠️ Мөр БАЙХГҮЙ бол кодын анхдагч текст ажиллана — админ юу ч
 * хийгээгүй байхад имэйл ЗОГСОХ ЁСГҮЙ.
 */
model EmailTemplateOverride {
  id String @id @default(cuid())

  /// Урсгалын түлхүүр — «winback-3d», «no-purchase-3d» г.м.
  campaign String @unique

  /// Имэйлийн гарчиг (subject). Хоосон бол кодын анхдагч.
  subject  String @default("")
  /// Дотоод том гарчиг
  heading  String @default("")
  /// Үндсэн бие — HTML зөвшөөрнө
  bodyHtml String @default("")
  /// Товчны текст
  ctaText  String @default("")

  /**
   * ⚠️ Энэ урсгалыг УНТРААХ товч. Админ тодорхой имэйл таалагдахгүй
   * бол кодыг хөндөхгүйгээр зогсоох боломжтой байх ёстой.
   */
  isEnabled Boolean @default(true)

  /// Хувийн купоны хямдрал (%) — 0 бол купон ОГТ өгөхгүй
  couponPercent Int @default(0)
  /// Купон хэдэн хоног хүчинтэй
  couponDays    Int @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * УТАС БАТАЛГААЖУУЛАХ SESSION — verify.mn MO SMS.
 * ⚠️⚠️ Энэ нь энгийн OTP БИШ. Бид код илгээдэггүй — ХЭРЭГЛЭГЧ өөрөө
 * үүсгэсэн кодыг 144773 руу SMS-ээр илгээнэ. verify.mn тэр ирсэн
 * SMS-ийн дугаарыг session-ий дугаартай тааруулж баталгаажуулна.
 * Ингэснээр дугаар нь ҮНЭХЭЭР тухайн хүнийх гэдэг нь батлагдана.
 * ⚠️⚠️ ХОЁР ӨӨР ID байгаа нь ЗОРИУД:
 * `id`                — өөрсдийн UUID. verify.mn-ий callback нь
 * БИЕГҮЙ ирдэг тул аль session болохыг зөвхөн
 * URL-ийн `?sid=` -ээр л ялгана. verify.mn-ий
 * sessionId-г урьдчилж мэдэх боломжгүй
 * (POST хариунаас л ирнэ) тул өөрсдийнхөө
 * ID-г урьдчилан үүсгэж callback-д суулгана.
 * `verifyMnSessionId` — verify.mn-ийх. Polling-д ашиглана.
 * ⚠️ User-тэй FK холбоогүй (EmailOtp-той ижил зарчим) — гараар цэвэрлэнэ.
 */
model PhoneVerifySession {
  id     String @id
  userId String
  /// Баталгаажуулж буй дугаар (нормалчилсан, 8 орон)
  phone  String
  /// Хэрэглэгчийн 144773 руу илгээх код (6 орон)
  code   String

  /// verify.mn-ий session ID — polling-д
  verifyMnSessionId String @unique

  /// pending | verified | expired
  status     String    @default("pending")
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@index([verifyMnSessionId])
}

// ─── ХАДМАЛ (SUBTITLE) ───────────────────────────────────────────────────────

/**
 * Киноны хадмал — ТУСДАА файл (видеон дээр шатаагаагүй).
 * ⚠️⚠️ ЯАГААД SOFT SUB ВЭ (hardsub-аас илүү):
 * • Засах: файл солиод дуусна. Hardsub бол видеог БҮХЭЛД НЬ дахин
 * encode (1-3 цаг) хийх ёстой.
 * • Олон хэл: нэг видео + жижиг файлууд. Hardsub бол хэл тус бүрд
 * ТУСДАА видео — R2 зай 3 дахин.
 * • Хэрэглэгч унтраах/сонгох боломжтой.
 * ⚠️ Кино (`titleId`) эсвэл анги (`episodeId`) — АЛЬ НЭГ нь заавал.
 * Хоёулаа хоосон бол ямар ч видеотой холбогдохгүй хог мөр үлдэнэ.
 * ⚠️ Файл нь R2-д ВСЕГДА `.vtt` хэлбэрээр хадгалагдана. Админ `.srt`
 * оруулсан ч backend хөрвүүлнэ — браузер `.srt`-г ОГТ уншдаггүй.
 */
model Subtitle {
  id String @id @default(cuid())

  /// Аль кинонд (нэг ангит) — `episodeId`-тэй ХАМТ хоосон байж болохгүй
  titleId String?
  title   Title?  @relation(fields: [titleId], references: [id], onDelete: Cascade)

  /// Аль ангид (олон ангит)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  /// ISO 639-1 хэлний код: mn | en | ko | ja | zh | ru
  lang  String
  /// Player-ийн цэсэнд харагдах нэр: «Монгол», «English»
  label String

  /// R2 key — ЗААВАЛ `.vtt` (`.srt` бол хөрвүүлээд хадгална)
  fileKey String

  /**
   * ⚠️ АНХДАГЧ — тоглуулах үед АВТОМАТ асна.
   * Нэг видеонд НЭГ л анхдагч байх ёстой (код талд хангана).
   */
  isDefault Boolean @default(false)

  /// Цэсэнд харагдах дараалал (бага нь эхэнд)
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ Нэг видеонд нэг хэл ДАВХАРДАХГҮЙ
  @@unique([titleId, lang])
  @@unique([episodeId, lang])
  @@index([titleId])
  @@index([episodeId])
}
