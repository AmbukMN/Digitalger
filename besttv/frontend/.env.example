API_URL=http://localhost:4100

# NextAuth — session encryption. Үүсгэх: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-besttv-nextauth-secret
NEXTAUTH_URL=http://localhost:3100

# Google OAuth — https://console.cloud.google.com/apis/credentials дээр
# "OAuth client ID" (Web application) үүсгэнэ. Authorized redirect URI:
# http://localhost:3100/api/auth/callback/google (prod: https://таны-домэйн/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth — https://developers.facebook.com/apps дээр Facebook Login
# бүтээгдэхүүн нэмнэ. Valid OAuth Redirect URI:
# http://localhost:3100/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
