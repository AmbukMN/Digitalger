# BestTV Backend (NestJS + Prisma)
# ⚠️ Build context = besttv/ (repo root), учир нь npm workspace бүтэцтэй.

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

# Workspace-ийн manifest-уудыг эхлээд (Docker layer cache — код өөрчлөгдөхөд
# npm install дахин ажиллахгүй)
COPY package*.json ./
COPY backend/package*.json ./backend/
COPY backend/prisma ./backend/prisma/

# Зөвхөн backend workspace-ыг суулгана (frontend/admin хэрэггүй)
RUN npm install --workspace backend --include-workspace-root --ignore-scripts

COPY backend ./backend/

WORKDIR /app/backend
RUN npx prisma generate && npm run build

# ── Stage 2: Runner ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# ffmpeg — HLS хөрвүүлэлт (worker VideoProcessor)
# postgresql-client — DB backup/pg_dump
RUN apk add --no-cache ffmpeg postgresql16-client wget

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/backend/node_modules ./backend/node_modules
COPY --from=builder --chown=nestjs:nodejs /app/backend/dist ./backend/dist
COPY --from=builder --chown=nestjs:nodejs /app/backend/package.json ./backend/package.json
COPY --from=builder --chown=nestjs:nodejs /app/backend/prisma ./backend/prisma

# Локал storage драйвер ашиглах үед (R2 тохируулаагүй) энэ хавтас руу бичнэ
RUN mkdir -p /app/backend/storage && chown -R nestjs:nodejs /app/backend/storage

USER nestjs
WORKDIR /app/backend

EXPOSE 4100

HEALTHCHECK --interval=30s --timeout=10s --start-period=45s --retries=3 \
  CMD wget -qO- http://localhost:4100/api/health || exit 1

# migrate deploy — контейнер асах бүрд шинэ migration автоматаар хэрэгжинэ
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main.js"]
