# DigitalGer — n8n Environment
# Local:      хоосон орхино, docker-compose.yml default утгуудаар ажиллана
# Production: бүх утгыг заавал тохируулна
#
# cp .env.example .env

# ── Host (production-д өөрчил) ────────────────────────────────────────────────
N8N_HOST=bot.digitalger.mn
N8N_PROTOCOL=https
WEBHOOK_URL=https://bot.digitalger.mn
N8N_EDITOR_BASE_URL=https://bot.digitalger.mn

# ── Timezone ──────────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Ulaanbaatar
TZ=Asia/Ulaanbaatar

# ── Auth (production-д заавал асаа) ──────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# ── Encryption key — ЗААВАЛ (openssl rand -hex 32) ───────────────────────────
# Энэ key алдагдвал бүх credential шифрлэлт эвдэрнэ — нууцалж хадгал
N8N_ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (анхны байршуулалтад хангалттай)
DB_TYPE=sqlite

# PostgreSQL (өсөлтийн үед шилжинэ)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SCHEMA=public

# ── AWS SES SMTP ──────────────────────────────────────────────────────────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
N8N_SMTP_SENDER=noreply@digitalger.mn
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true

# ── Logging ───────────────────────────────────────────────────────────────────
N8N_LOG_LEVEL=info
N8N_PAYLOAD_SIZE_MAX=64
N8N_METRICS=false

# ── Ирээдүйн интеграц (credential болгон тохируулна) ─────────────────────────
# DIGITALGER_API_URL=https://api.digitalger.mn
# DIGITALGER_API_KEY=
# TELEGRAM_BOT_TOKEN=
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=
# ANTHROPIC_API_KEY=
