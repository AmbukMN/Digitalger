# DigitalGer — n8n Environment Configuration
# Copy to .env and fill in values before starting
# cp .env.example .env

# ─── Host ────────────────────────────────────────────────────────────────────
N8N_HOST=bot.digitalger.mn
N8N_PROTOCOL=https
WEBHOOK_URL=https://bot.digitalger.mn
N8N_EDITOR_BASE_URL=https://bot.digitalger.mn

# ─── Timezone ────────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Ulaanbaatar
TZ=Asia/Ulaanbaatar

# ─── Auth ────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong-password

# REQUIRED: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ─── Database (default: SQLite, upgrade to PostgreSQL for production) ─────────
DB_TYPE=sqlite

# PostgreSQL (uncomment when scaling)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SCHEMA=public

# ─── Email (AWS SES SMTP) ─────────────────────────────────────────────────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
N8N_SMTP_SENDER=noreply@digitalger.mn
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true

# ─── Redis (for queue mode — enable when adding workers) ──────────────────────
# EXECUTIONS_MODE=queue
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
N8N_LOG_LEVEL=info

# ─── Limits ──────────────────────────────────────────────────────────────────
# Max webhook/API payload in MB
N8N_PAYLOAD_SIZE_MAX=64

# ─── Metrics (Prometheus) ─────────────────────────────────────────────────────
N8N_METRICS=false

# ─── Future: DigitalGer API ───────────────────────────────────────────────────
# DIGITALGER_API_URL=https://api.digitalger.mn
# DIGITALGER_API_KEY=

# ─── Future: Telegram bot ─────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=

# ─── Future: Facebook / Meta ──────────────────────────────────────────────────
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=

# ─── Future: pgvector (AI memory) ────────────────────────────────────────────
# PGVECTOR_HOST=
# PGVECTOR_DATABASE=
# PGVECTOR_USER=
# PGVECTOR_PASSWORD=

# ─── Future: Anthropic (AI agents) ───────────────────────────────────────────
# ANTHROPIC_API_KEY=
