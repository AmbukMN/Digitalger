# DigitalGer — n8n Production Environment
# cp .env.example .env  →  бүх утгыг тохируул

# ── Host ──────────────────────────────────────────────────────────────────────
N8N_HOST=bot.digitalger.mn
N8N_PROTOCOL=https
WEBHOOK_URL=https://bot.digitalger.mn
N8N_EDITOR_BASE_URL=https://bot.digitalger.mn

# ── Timezone ──────────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Ulaanbaatar
TZ=Asia/Ulaanbaatar

# ── Auth (production-д заавал асаа) ──────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# ── Encryption (openssl rand -hex 32) — алдагдвал бүх credential устна ────────
N8N_ENCRYPTION_KEY=

# ── PostgreSQL — n8n тусгай DB (DigitalGer business DB-ТАС ТУСДАА) ───────────
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# ── AWS SES SMTP ──────────────────────────────────────────────────────────────
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
N8N_SMTP_SENDER=noreply@digitalger.mn
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true

# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token: @BotFather-с авна
TELEGRAM_BOT_TOKEN=
# Admin chat ID: @userinfobot-с авна
TELEGRAM_ADMIN_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
N8N_LOG_LEVEL=info
N8N_PAYLOAD_SIZE_MAX=64
N8N_METRICS=false

# ── Ирээдүйн интеграц ─────────────────────────────────────────────────────────
# DIGITALGER_API_URL=https://api.digitalger.mn
# DIGITALGER_API_KEY=
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=
# ANTHROPIC_API_KEY=
