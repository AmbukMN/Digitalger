      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst amount = Number(body.amount ?? 0).toLocaleString('mn-MN');\nconst shortId = (body.orderId ?? '').slice(-8).toUpperCase();\nconst user = [body.userName, body.userEmail].filter(Boolean).join(' / ') || 'Тодорхойгүй';\nconst reason = body.reason || 'UNKNOWN';\nconst failedAt = body.failedAt\n  ? new Date(body.failedAt).toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' })\n  : new Date().toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' });\n\nreturn [{\n  json: {\n    message: `Төлбөр амжилтгүй болов!\\n\\n` +\n      `Хэрэглэгч: ${user}\\n` +\n      `Дүн: ${amount}t\\n` +\n      `ID: ${shortId}\\n` +\n      `Шалтгаан: ${reason}\\n` +\n      `Цаг: ${failedAt}`\n  }\n}];"
      },
