    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst products = (body.products ?? []);\nconst productLines = products\n  .map((p, i) => `  ${i + 1}. ${p.title} — ${Number(p.price).toLocaleString('mn-MN')}t`)\n  .join('\\n');\n\nconst amount = Number(body.amount ?? 0).toLocaleString('mn-MN');\nconst shortId = (body.orderId ?? '').slice(-8).toUpperCase();\nconst user = [body.userName, body.userEmail].filter(Boolean).join(' / ') || 'Тодорхойгүй';\n\nconst paidAt = body.paidAt\n  ? new Date(body.paidAt).toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' })\n  : new Date().toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' });\n\nconst productCount = products.length;\nconst productSummary = productCount === 1\n  ? products[0]?.title ?? 'Тодорхойгүй'\n  : `${productCount} бүтээгдэхүүн`;\n\nconst message = `Шинэ төлбөр амжилттай!\\n\\n` +\n  `Хэрэглэгч: ${user}\\n` +\n  `Захиалга: ${productSummary}\\n` +\n  `Нийт дүн: ${amount}t\\n` +\n  `ID: ${shortId}\\n` +\n  (productCount > 1 ? `\\nБүтээгдэхүүн:\\n${productLines}\\n` : '') +\n  `Төлөв: ТӨЛӨГДСӨН\\n` +\n  `Цаг: ${paidAt}`;\n\nreturn [{ json: { message } }];"
      },
      "id": "b2c3d4e5-0002-0002-0002-000000000040",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
