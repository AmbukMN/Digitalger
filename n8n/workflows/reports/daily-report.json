    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst revenue = Number(body.totalRevenue ?? 0).toLocaleString('mn-MN');\nconst date = body.date || new Date().toISOString().split('T')[0];\nconst topProducts = (body.topProducts ?? []);\n\nconst topLines = topProducts.length > 0\n  ? topProducts\n      .map((p, i) => `  ${i + 1}. ${p.title} — ${p.count}ш / ${Number(p.revenue).toLocaleString('mn-MN')}t`)\n      .join('\\n')\n  : '  Борлуулалт байхгүй';\n\nreturn [{\n  json: {\n    message: `Өдрийн тайлан — ${date}\\n\\n` +\n      `Орлого: ${revenue}t\\n` +\n      `Захиалга: ${body.orderCount ?? 0}\\n` +\n      `Шинэ хэрэглэгч: ${body.newUserCount ?? 0}\\n\\n` +\n      `Шилдэг бүтээгдэхүүн:\\n${topLines}`\n  }\n}];"
      },
      "id": "e5f6a7b8-0005-0005-0005-000000000040",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
