      "parameters": {
        "jsCode": "const body = $input.item.json.body;\n\nconst price = Number(body.price ?? 0).toLocaleString('mn-MN');\nconst category = body.categoryName || 'Ангилалгүй';\nconst publishedAt = body.publishedAt\n  ? new Date(body.publishedAt).toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' })\n  : new Date().toLocaleString('mn-MN', { timeZone: 'Asia/Ulaanbaatar' });\n\nreturn [{\n  json: {\n    message: `Шинэ бүтээгдэхүүн нийтлэгдлээ!\\n\\n` +\n      `Нэр: ${body.title}\\n` +\n      `Ангилал: ${category}\\n` +\n      `Үнэ: ${price}t\\n` +\n      `Slug: ${body.slug}\\n` +\n      `Цаг: ${publishedAt}`\n  }\n}];"
      },
      "id": "d4e5f6a7-0004-0004-0004-000000000040",
