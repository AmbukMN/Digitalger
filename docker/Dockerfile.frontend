# Stage 1: Install dependencies
# Fresh install (no lockfile) so Alpine gets correct platform binaries
# (lightningcss-linux-x64-musl, @tailwindcss/oxide-linux-x64-musl, etc.)
FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
RUN mkdir -p admin backend

RUN npm install --workspace=shared --workspace=frontend

# Stage 2: Build
FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY shared ./shared
COPY frontend ./frontend

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/frontend
RUN node /app/node_modules/.bin/next build

# Resolve all symlinks in standalone output → actual files
# (workspace-hoisted node_modules creates symlinks that break in the runner)
RUN cp -rL /app/frontend/.next/standalone /tmp/standalone-frontend

# Stage 3: Production runner (non-root)
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /tmp/standalone-frontend ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./frontend/public
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./frontend/.next/static

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "frontend/server.js"]
