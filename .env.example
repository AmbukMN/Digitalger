# DigitalGer — Docker Local Environment Example
# Copy to .env.docker and fill in real values.
# DO NOT commit real secrets.

NODE_ENV=production
PORT=4000

# PostgreSQL
POSTGRES_USER=digitalger
POSTGRES_PASSWORD=digitalger_secret
POSTGRES_DB=digitalger
DATABASE_URL=postgresql://digitalger:digitalger_secret@postgres:5432/digitalger?schema=public

# Redis (Docker internal)
REDIS_URL=redis://redis:6379

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# URLs (Docker local)
FRONTEND_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:3101

# Next.js Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me-in-production

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digitalger-assets
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.digitalger.mn

# QPay
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/api/payments/webhook
QPAY_WEBHOOK_SECRET=dev-webhook-secret

# AWS SES (email delivery)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=noreply@digitalger.mn

# Anthropic AI (optional)
ANTHROPIC_API_KEY=
