# DigitalGer — Environment Variables Template
# Copy to .env.local (frontend/admin) or .env (backend) for local development.
# For production, use a single /opt/DigitalGer/.env.production file.
# See docs/ENVIRONMENT.md for full documentation.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=digitalger
POSTGRES_PASSWORD=digitalger_secret
POSTGRES_DB=digitalger
DATABASE_URL=postgresql://digitalger:digitalger_secret@localhost:5433/digitalger?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Next.js (Frontend) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# ── Next.js (Admin) ───────────────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3001   (admin uses port 3001)
# NEXTAUTH_SECRET=same-as-frontend-secret

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=digitalger-assets
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.digitalger.mn

# ── QPay ─────────────────────────────────────────────────────────────────────
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/api/payments/webhook
QPAY_WEBHOOK_SECRET=change-me-webhook-secret

# ── Anthropic AI (optional) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
