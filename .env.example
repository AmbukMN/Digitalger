# DigitalGer — Docker Local Validation Environment
# DO NOT COMMIT — gitignored

NODE_ENV=production
PORT=4000

# PostgreSQL
POSTGRES_USER=digitalger
POSTGRES_PASSWORD=digitalger_secret
POSTGRES_DB=digitalger
DATABASE_URL=postgresql://digitalger:digitalger_secret@postgres:5432/digitalger?schema=public

# Redis (Docker internal)
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=digitalger-jwt-secret-change-me
JWT_REFRESH_SECRET=digitalger-refresh-secret-change-me
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# URLs (Docker local)
FRONTEND_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3100,http://localhost:3101

# Next.js Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=digitalger-nextauth-secret-dev-2024

# Next.js Admin (override NEXTAUTH_URL at service level)
# NEXTAUTH_URL overridden per-service in compose

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digitalger-assets
R2_ENDPOINT=https://ba4f58a1be1ffc9a9dbb58419b726891.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-56e173698658449685aec1a3fc320b5a.r2.dev

# QPay
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
