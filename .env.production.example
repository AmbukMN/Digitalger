# DigitalGer — PRODUCTION Environment Variables
# Location on server: /opt/DigitalGer/.env.production
# Permission: chmod 600 /opt/DigitalGer/.env.production
# Owner: root or deploy user only
#
# All Docker services load this single file via:
#   env_file: /opt/DigitalGer/.env.production
#
# NEVER commit the real .env.production to git.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=digitalger
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=digitalger
DATABASE_URL=postgresql://digitalger:GENERATE_STRONG_PASSWORD_HERE@postgres:5432/digitalger?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT (generate with: openssl rand -hex 64) ────────────────────────────────
JWT_SECRET=GENERATE_64_CHAR_HEX_SECRET
JWT_REFRESH_SECRET=GENERATE_64_CHAR_HEX_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://digitalger.mn
ADMIN_URL=https://admin.digitalger.mn
API_URL=https://api.digitalger.mn
CORS_ORIGIN=https://digitalger.mn,https://admin.digitalger.mn

# ── Next.js (Frontend) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://digitalger.mn
NEXT_PUBLIC_API_URL=https://api.digitalger.mn
NEXTAUTH_URL=https://digitalger.mn
NEXTAUTH_SECRET=GENERATE_64_CHAR_HEX_NEXTAUTH_SECRET

# ── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=digitalger-assets
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.digitalger.mn

# ── QPay ─────────────────────────────────────────────────────────────────────
QPAY_USERNAME=your_qpay_username
QPAY_PASSWORD=your_qpay_password
QPAY_INVOICE_CODE=your_invoice_code
QPAY_CALLBACK_URL=https://api.digitalger.mn/api/payments/webhook
QPAY_WEBHOOK_SECRET=GENERATE_64_CHAR_HEX_WEBHOOK_SECRET

# ── AWS SES (email delivery) ──────────────────────────────────────────────────
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
MAIL_FROM=noreply@digitalger.mn
# --- Resend (имэйл, AWS SES-ийн оронд түр) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ── Anthropic AI (optional) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
